[package]
name = "patra"
version = "${file:VERSION}"
description = "Patra — structured storage and SQL queries for Cyrius. The sovereign database."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.6"
repository = "https://github.com/MacCracken/patra"

[build]
entry = "src/lib.cyr"
output = "patra"

# Order must match src/lib.cyr's include order — `cyrius distlib` concatenates
# in this order and cyrius resolves forward references in a single pass.
[lib]
modules = [
    "src/file.cyr",
    "src/pcache.cyr",
    "src/wal.cyr",
    "src/page.cyr",
    "src/row.cyr",
    "src/bytes.cyr",
    "src/sql.cyr",
    "src/where.cyr",
    "src/btree.cyr",
    "src/table.cyr",
    "src/jsonl.cyr",
    "src/lib.cyr",
]

# Order mirrors the includes at the top of src/lib.cyr — sakshi last.
# patra's fold uses ONE sakshi symbol: sakshi_error (src/file.cyr, _pt_err). The
# sakshi_set_level call was removed from patra_init at v1.13.10 (it clobbered
# the host's process-global log level); patra_init in src/lib.cyr says so. The
# remaining sakshi_set_level / sakshi_get_level calls are test-only, exercising
# that fix. chrono and random (1.15.0) supply clock_epoch_secs and random_bytes
# to src/wal.cyr, replacing raw syscalls.
[deps]
stdlib = ["syscalls", "string", "alloc", "freelist", "io", "fmt", "str", "vec", "atomic", "sync", "thread_local", "chrono", "random", "sakshi"]

# Three rules for this file. All three have already been violated once —
# rule 3 during the very cut that added it.
#
# 1. Never write a bracketed deps.NAME section header inside a comment —
#    backtick it as `deps.NAME` instead.
#
#    ⚠ This is now DEFENCE IN DEPTH, not a live defect. The upstream cause was
#    fixed in cyrius 6.5.28 (2026-08-18): `_distlib_named_deps` scanned for the
#    opening bracket sequence unanchored (cbt/commands.cyr) and matched it inside
#    comment prose, dropping NAME from the .deps sidecar — dist/patra.deps
#    silently shipped 11 leaves against 12, missing sakshi, from <=1.12.11
#    through 1.13.1. Worked around here at 1.13.2, CI-gated at 1.13.7, and the
#    filing archived at 1.13.12 after mutation-verifying the upstream fix under
#    6.6.0: three comment shapes all still emit 12 leaves.
#
#    The rule stays because the convention costs nothing, protects anyone
#    building on a pre-6.5.28 toolchain, and two narrow parser holes remain
#    upstream (an unbounded `]` search; TOML triple-quoted strings) — see
#    docs/development/issues/archive/2026-08-18-cyrius-distlib-named-deps-unanchored-scan.md.
#
# 2. Never add a git `deps.X` block for anything the cyrius stdlib folds.
#    `cyrius deps` overlays a git dep on top of the snapshot on every build,
#    recursing through sibling manifests — so a stale pin here overrides what
#    every downstream consumer resolves, and `deps --verify` cannot catch it
#    (the lock is written from disk, recording the downgraded hash). patra is
#    itself folded, so this reached four levels down. On a bundle-publishing
#    library it also drops the module from the .deps sidecar.
#    History: `deps.sakshi` 2.4.2, removed at 1.13.0. See CHANGELOG [1.13.0].
#
# 3. Never write a double-quote character in a comment below the `deps`
#    section. Added at 1.13.12, after a comment edit in THIS block broke the CI
#    sidecar gate: it counted the declared leaves by sed-ing from the section
#    header to the next line starting with `[` — which is EOF here — and then
#    grepping a quoted-lowercase-token pattern over the whole tail, so a stray
#    triple-quote in prose read as
#    a 13th declared leaf against 12 emitted. Same shape as the distlib bug in
#    rule 1: an unanchored scan matching comment prose.
#
#    The gate was hardened at the same time to read only the `stdlib = ` line,
#    so this rule is now belt-and-braces — but the rule is cheaper than
#    re-learning it.
