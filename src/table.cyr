# table.cyr — table metadata, create, insert, scan, update, delete

# The (page, slot) ref of the row tbl_insert stored last, read by its caller to
# index the row. Per thread since 1.16.2 (it was a process global): statements
# inside a transaction do not take the statement mutex, so two threads each in
# a transaction on its own database overwrote each other's between the insert
# and the index entry (btree.cyr BtSplitCtx). Slot claimed by _patra_tls_ensure.  #skip-lint
var TLS_LASTREF = 0 - 1;

fn _tbl_last_ref_get(): i64 {
    if (TLS_LASTREF < 0) { _patra_tls_ensure(); }
    return thread_local_get(TLS_LASTREF);
}

fn _tbl_last_ref_set(v): i64 {
    if (TLS_LASTREF < 0) { _patra_tls_ensure(); }
    thread_local_set(TLS_LASTREF, v);
    return 0;
}

# The table-insert tail-page cache lives in the db handle (DB_LP_IDX /
# DB_LP_PAGE / DB_LP_GEN, lib.cyr). tbl_insert takes a pointer `lpc` to those
# three contiguous i64 words: [0]=cached table idx (-1 = empty), [1]=cached
# tail data-page number, [2]=the commit-gen the cache was stamped at. Per-handle
# (was process-global pre-v1.12.7) so connection-per-thread readers/writers
# don't race a shared cache; gen-gated against HDR_COMMITGEN so a commit on
# another handle/process invalidates it.

# Rows matched by the most recent tbl_update / tbl_delete. lib.cyr lifts this
# into the db handle's DB_ROWS_AFFECTED after a successful exec (the DB struct
# lives in lib.cyr, which is included last — the same handshake as
# _tbl_last_ref_get). v1.11.3, yeo-cy-test changes()-style readback. Per thread
# since 1.16.2, for the same reason.  #skip-lint
var TLS_AFFECTED = 0 - 1;

fn _tbl_rows_affected_get(): i64 {
    if (TLS_AFFECTED < 0) { _patra_tls_ensure(); }
    return thread_local_get(TLS_AFFECTED);
}

fn _tbl_rows_affected_set(v): i64 {
    if (TLS_AFFECTED < 0) { _patra_tls_ensure(); }
    thread_local_set(TLS_AFFECTED, v);
    return 0;
}

fn _tbl_entry(hdr, idx): i64 {
    return hdr + HDR_TBLDIR + idx * TBL_ENTRY_SZ;
}

fn _tbl_name_eq(entry, name, nlen): i64 {
    var elen = strlen(entry + TBL_NAME);
    if (elen != nlen) { return 0; }
    return memeq(entry + TBL_NAME, name, nlen);
}

# Free any BLOB chains referenced by this row. Called before a row's
# storage is reclaimed (DROP TABLE, DELETE, ALTER DROP). No-op if the
# schema has no BLOB columns. Also used during ALTER DROP COLUMN on a
# BLOB column, where the dropped column's chain must be freed; in that
# case the caller skips the row-wide sweep and targets the one column.
fn _tbl_free_row_bytes(fd, hdr, row, schema, ncols): i64 {
    for (var i = 0; i < ncols; i = i + 1) {
        var ctype = load64(schema + SCH_START + i * SCH_ENTRY_SZ + SCH_CTYPE);
        if (_col_is_chain(ctype)) {
            var off = row_field_offset(schema, ncols, i);
            var first_pg = row_read_bytes_page(row, off);
            if (first_pg != 0) {
                _bytes_free_chain(fd, hdr, first_pg);
            }
        }
    }
    return 0;
}

# True (1) if the schema has at least one BLOB column. Cheap guard so
# non-BLOB tables skip the per-row chain scan on DROP/DELETE.
fn _tbl_has_bytes(schema, ncols): i64 {
    for (var i = 0; i < ncols; i = i + 1) {
        var ctype = load64(schema + SCH_START + i * SCH_ENTRY_SZ + SCH_CTYPE);
        if (_col_is_chain(ctype)) { return 1; }
    }
    return 0;
}

# Find table by name, returns index or -1
#
# 1.16.1: the scan is bounded by the directory's MAX_TABLES slots, as
# _sch_ncols_clamped bounds a schema page. HDR_TBLCOUNT is re-read from disk
# by every statement and checked only by patra_open's patra_hdr_verify, so a
# count written after the open (another process, corruption) walked past the
# header page. tbl_create now calls this before its cap test, so for CREATE
# TABLE that was a new fault: 1.16.0's cap-first order returned
# PATRA_ERR_FULL.
fn tbl_find(hdr, name, nlen): i64 {
    var count = load64(hdr + HDR_TBLCOUNT);
    if (count > MAX_TABLES) { count = MAX_TABLES; }
    for (var i = 0; i < count; i = i + 1) {
        if (_tbl_name_eq(_tbl_entry(hdr, i), name, nlen)) {
            return i;
        }
    }
    return 0 - 1;
}

# col_names: array of (ptr, len) pairs — 16 bytes each
# col_types: array of i64 — 8 bytes each
# Create table with schema and data pages
fn tbl_create(fd, hdr, name, nlen, col_names, col_types, ncols, autoinc): i64 {
    if (ncols > MAX_COLS) { return PATRA_ERR_COLCOUNT; }
    # 1.16.2: at least one column — patra_hdr_verify rejects a directory entry
    # with none, so creating one made the file unopenable.
    if (ncols < 1) { return PATRA_ERR_COLCOUNT; }
    # 1.16.0: a name that does not fit its slot is refused, before anything is
    # allocated, rather than clamped to 31 bytes below — the parser refuses it
    # first (sql.cyr _ident_fits); this keeps a direct caller honest too. A
    # clamped table name could never be looked up again.
    if (nlen > TBL_NAME_MAX - 1) { return PATRA_ERR_SYNTAX; }
    for (var cl_i = 0; cl_i < ncols; cl_i = cl_i + 1) {
        if (load64(col_names + cl_i * 16 + 8) > SCH_CNAME_MAX - 1) { return PATRA_ERR_SYNTAX; }
    }
    # 1.16.2: column names are distinct, compared as _wh_resolve_col compares
    # them (exact bytes). A repeat was accepted and left a column no statement
    # could name, where ADD COLUMN / RENAME COLUMN refuse one with EXISTS.
    for (var dj = 1; dj < ncols; dj = dj + 1) {
        var dlen = load64(col_names + dj * 16 + 8);
        var dptr = load64(col_names + dj * 16);
        for (var dk = 0; dk < dj; dk = dk + 1) {
            if (load64(col_names + dk * 16 + 8) == dlen) {
                if (memeq(load64(col_names + dk * 16), dptr, dlen)) { return PATRA_ERR_EXISTS; }
            }
        }
    }
    if (tbl_find(hdr, name, nlen) >= 0) { return PATRA_ERR_EXISTS; }
    # 1.16.1: the cap is tested AFTER the name. It came first, so in a file
    # holding MAX_TABLES tables, creating one of them answered PATRA_ERR_FULL
    # where any smaller file answered PATRA_ERR_EXISTS — and a caller that reads
    # EXISTS as "already there" (libro's patrastore_open) refused a valid store.
    if (load64(hdr + HDR_TBLCOUNT) >= MAX_TABLES) { return PATRA_ERR_FULL; }

    # A row must fit inside ONE data page. MAX_COLS caps the column COUNT, but
    # that is not the binding constraint: 16 STR columns is a legal count and a
    # 4096-byte row, which cannot fit the PAGE_SIZE - DP_DATA (4072) data area.
    # Reject at create time — otherwise tbl_insert's fresh-page branch memcpys
    # the row past the end of the page buffer. (audit 2026-08-18 S0-1)
    var rowsz = 0;
    for (var rc_i = 0; rc_i < ncols; rc_i = rc_i + 1) {
        rowsz = rowsz + row_col_size(load64(col_types + rc_i * 8));
    }
    if (rowsz > PAGE_SIZE - DP_DATA) { return PATRA_ERR_ROWSZ; }

    # 1.16.2: everything this needs is allocated before anything is written,
    # as in ALTER (lib.cyr _exec_alter_add): the two page buffers (memory
    # only), the schema and data pages (page_alloc writes nothing when it takes
    # a page off the free list, and an extension lands past the on-disk page
    # count), and the auto-index root last, because btree_create writes its
    # page. A refusal gives back what the allocations advanced in the header and
    # leaves the file as it was. Before, a refused data page came after the
    # schema page was written — over a page the on-disk free list still listed
    # — and both buffers were unchecked.
    var sbuf = pg_alloc();
    var dbuf = pg_alloc();
    var pc_snap = load64(hdr + HDR_PGCOUNT);
    var fh_snap = load64(hdr + HDR_FREEHEAD);
    var spg = 0;
    var dpg = 0;
    var bt = 0;
    var want_bt = 0;
    if (load64(col_types) == COL_INT) { want_bt = 1; }
    if (sbuf != 0) {
        if (dbuf != 0) {
            spg = page_alloc(fd, hdr);
            if (spg != 0) { dpg = page_alloc(fd, hdr); }
            if (dpg != 0) {
                if (want_bt != 0) { bt = btree_create(fd, hdr); }
            }
        }
    }
    var ok = 1;
    if (dpg == 0) { ok = 0; }
    if (want_bt != 0) { if (bt == 0) { ok = 0; } }
    if (ok == 0) {
        store64(hdr + HDR_PGCOUNT, pc_snap);
        store64(hdr + HDR_FREEHEAD, fh_snap);
        pg_free(sbuf);
        pg_free(dbuf);
        if (sbuf == 0) { return PATRA_ERR_IO; }
        if (dbuf == 0) { return PATRA_ERR_IO; }
        return PATRA_ERR_FULL;
    }

    memset(sbuf, 0, PAGE_SIZE);
    store64(sbuf + SCH_NCOLS, ncols);

    for (var i = 0; i < ncols; i = i + 1) {
        var soff = SCH_START + i * SCH_ENTRY_SZ;
        var np = load64(col_names + i * 16);
        var nl = load64(col_names + i * 16 + 8);
        var cn = nl;
        if (cn > SCH_CNAME_MAX - 1) { cn = SCH_CNAME_MAX - 1; }
        memcpy(sbuf + soff + SCH_CNAME, np, cn);
        store8(sbuf + soff + SCH_CNAME + cn, 0);
        store64(sbuf + soff + SCH_CTYPE, load64(col_types + i * 8));
    }
    # AUTOINCREMENT column marker: col_idx+1, 0 = none (memset already zeroed
    # it, so old DBs read 0 = none — backward-compatible additive field).
    store64(sbuf + SCH_AUTOINC_COL, autoinc);
    # Auto-index on first INT column (its root allocated above)
    store64(sbuf + SCH_IDX_COL, 0 - 1);
    if (want_bt != 0) {
        store64(sbuf + SCH_IDX_COL, 0);
        store64(sbuf + SCH_IDX_ROOT, bt);
    }
    page_write(fd, spg, sbuf);
    pg_free(sbuf);

    page_init_data(dbuf);
    page_write(fd, dpg, dbuf);
    pg_free(dbuf);

    var idx = load64(hdr + HDR_TBLCOUNT);
    var entry = _tbl_entry(hdr, idx);
    memset(entry, 0, TBL_ENTRY_SZ);
    var nn = nlen;
    if (nn > TBL_NAME_MAX - 1) { nn = TBL_NAME_MAX - 1; }
    memcpy(entry + TBL_NAME, name, nn);
    store8(entry + TBL_NAME + nn, 0);
    store64(entry + TBL_NCOLS, ncols);
    store64(entry + TBL_ROOT, dpg);
    store64(entry + TBL_NROWS, 0);
    store64(entry + TBL_SCHEMA, spg);
    store64(hdr + HDR_TBLCOUNT, idx + 1);

    return PATRA_OK;
}

# Drop table: free data pages, schema page, compact directory.
# Caller (lib.cyr _exec_drop) invalidates the per-handle tail-page cache.
fn tbl_drop(fd, hdr, idx): i64 {
    var entry = _tbl_entry(hdr, idx);
    var spg = load64(entry + TBL_SCHEMA);

    # 1.16.2: the three page buffers first, checked (a refusal was a read or a
    # load through 0), before anything is freed.
    var schema = pg_alloc();
    var buf = pg_alloc();
    var sbuf = pg_alloc();
    if (schema == 0) { pg_free(buf); pg_free(sbuf); return PATRA_ERR_IO; }
    if (buf == 0) { pg_free(schema); pg_free(sbuf); return PATRA_ERR_IO; }
    if (sbuf == 0) { pg_free(schema); pg_free(buf); return PATRA_ERR_IO; }

    # Read schema to learn the row layout (for BLOB cleanup)
    page_read(fd, spg, schema);
    var ncols = _sch_ncols_clamped(schema);
    var has_blob = _tbl_has_bytes(schema, ncols);
    var row_sz = row_compute_size(schema, ncols);

    # Free BLOB chains referenced by every row, then free the data pages.
    # If there are no BLOB columns the row walk is skipped entirely.
    # 1.14.0: bound the chain walk. DP_NEXT is read straight off a data page,
    # so a crafted or torn file can make the chain cyclic — and every one of
    # these walks runs INSIDE the statement's flock window, so a cycle hung the
    # database for every other process until the hang was killed. A legitimate
    # chain visits each page at most once, so the file's page count is a
    # correct and generous bound.
    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    var cur = load64(entry + TBL_ROOT);
    while (cur != 0) {
        hops = hops + 1;
        if (hops > maxhops) { cur = 0; continue; }
        page_read(fd, cur, buf);
        if (has_blob != 0) {
            var nr = _dp_nrows_clamped(buf, row_sz);
            for (var ri = 0; ri < nr; ri = ri + 1) {
                _tbl_free_row_bytes(fd, hdr, buf + DP_DATA + ri * row_sz, schema, ncols);
            }
        }
        var next = load64(buf + DP_NEXT);
        page_free(fd, hdr, cur);
        cur = next;
    }
    pg_free(schema);

    # Free B-tree pages (walk from schema index root)
    page_read(fd, spg, sbuf);
    var ic = load64(sbuf + SCH_IDX_COL);
    if (ic >= 0) {
        var ir = load64(sbuf + SCH_IDX_ROOT);
        if (ir != 0) {
            btree_free_all(fd, hdr, ir);
        }
    }
    pg_free(sbuf);

    # Free schema page
    page_free(fd, hdr, spg);

    # Compact table directory: shift entries after idx left by one
    var count = load64(hdr + HDR_TBLCOUNT);
    var i = idx;
    while (i < count - 1) {
        var dst = _tbl_entry(hdr, i);
        var src = _tbl_entry(hdr, i + 1);
        memcpy(dst, src, TBL_ENTRY_SZ);
        i = i + 1;
    }
    store64(hdr + HDR_TBLCOUNT, count - 1);

    pg_free(buf);
    return PATRA_OK;
}

# Insert a row into table. `lpc` -> the handle's 3-word tail-page cache
# (idx, page, gen); see the note at the top of this file.
fn tbl_insert(fd, hdr, idx, row_data, row_sz, lpc): i64 {
    # Defence in depth: tbl_create rejects a schema whose row cannot fit a page,
    # but a row wider than the data area would silently overflow the fresh-page
    # memcpy below, so refuse it here too rather than trusting the schema on
    # disk. (audit 2026-08-18 S0-1)
    if (row_sz > PAGE_SIZE - DP_DATA) { return PATRA_ERR_ROWSZ; }
    var entry = _tbl_entry(hdr, idx);
    var buf = pg_alloc();
    if (buf == 0) { return PATRA_ERR_IO; }      # 1.16.2: checked

    # Trust the cached tail page only if it is for THIS table AND stamped at the
    # current commit generation. _pc_refresh re-read the on-disk header (and its
    # HDR_COMMITGEN) at the top of this locked op, so a stale gen here means a
    # commit landed on another handle/process since we cached — walk afresh.
    var gen = load64(hdr + HDR_COMMITGEN);
    var hit = 0;
    if (load64(lpc) == idx) {
        if (load64(lpc + 16) == gen) { hit = 1; }
    }

    var cur = 0;
    if (hit == 1) {
        cur = load64(lpc + 8);
        page_read(fd, cur, buf);
    } else {
        cur = load64(entry + TBL_ROOT);
        page_read(fd, cur, buf);
        # 1.14.0: bounded — see the note in tbl_drop. A cyclic DP_NEXT spun
        # this tail-walk forever with the write lock held.
        var thops = 0;
        var tmax = load64(hdr + HDR_PGCOUNT);
        if (tmax < 1) { tmax = 1; }
        var tstop = 0;
        while (tstop == 0) {
            if (load64(buf + DP_NEXT) == 0) { tstop = 1; continue; }
            thops = thops + 1;
            if (thops > tmax) { tstop = 1; continue; }
            cur = load64(buf + DP_NEXT);
            page_read(fd, cur, buf);
        }
    }

    var nrows = _dp_nrows_clamped(buf, row_sz);
    var used = DP_DATA + nrows * row_sz;

    if (used + row_sz <= PAGE_SIZE) {
        _tbl_last_ref_set(_bt_mkref(cur, nrows));
        memcpy(buf + used, row_data, row_sz);
        store64(buf + DP_NROWS, nrows + 1);
        page_write(fd, cur, buf);
        store64(lpc, idx);
        store64(lpc + 8, cur);
        store64(lpc + 16, gen);
    } else {
        var npg = page_alloc(fd, hdr);
        if (npg == 0) { pg_free(buf); return PATRA_ERR_FULL; }
        store64(buf + DP_NEXT, npg);
        page_write(fd, cur, buf);

        _tbl_last_ref_set(_bt_mkref(npg, 0));
        page_init_data(buf);
        memcpy(buf + DP_DATA, row_data, row_sz);
        store64(buf + DP_NROWS, 1);
        page_write(fd, npg, buf);
        store64(lpc, idx);
        store64(lpc + 8, npg);
        store64(lpc + 16, gen);
    }

    var rc = load64(entry + TBL_NROWS);
    store64(entry + TBL_NROWS, rc + 1);

    pg_free(buf);
    return PATRA_OK;
}

# Scan all rows (no filter). Returns rows copied.
# Scan all rows into output buffer, returns count
# Rows actually addressable on a data page. DP_NROWS is read from disk and is
# therefore untrusted: a corrupt or hostile value drove both the scan loop bound
# and the number of bytes copied out. Cap it at what the page can physically
# hold. (audit 2026-08-18 S0-5)
fn _dp_nrows_clamped(buf, row_sz): i64 {
    var nr = load64(buf + DP_NROWS);
    if (nr < 0) { return 0; }
    if (row_sz <= 0) { return 0; }
    var pcap = (PAGE_SIZE - DP_DATA) / row_sz;
    if (nr > pcap) { nr = pcap; }
    return nr;
}

# Same clamp with the per-page capacity precomputed. The division above is
# loop-invariant across a chain walk, and paying it per page cost ~7% on
# read_scan_4t_par when the clamps went in at 1.14.0. The two hot scan loops
# hoist it with _dp_pcap and call this; every cold path keeps the
# one-argument form, which is harder to get wrong.
fn _dp_pcap(row_sz): i64 {
    if (row_sz <= 0) { return 0; }
    return (PAGE_SIZE - DP_DATA) / row_sz;
}

fn _dp_nrows_cap(buf, pcap): i64 {
    var nr = load64(buf + DP_NROWS);
    if (nr < 0) { return 0; }
    if (nr > pcap) { return pcap; }
    return nr;
}

# `cap` is the number of rows `out` can hold. Currently unused in-tree, but
# bounded regardless: an unbounded memcpy driven by an on-disk DP_NROWS is not
# something to leave lying around for a future caller. (audit 2026-08-18 S0-5)
fn tbl_scan(fd, hdr, idx, out, row_sz, cap): i64 {
    var entry = _tbl_entry(hdr, idx);
    var cur = load64(entry + TBL_ROOT);
    var buf = pg_alloc();
    if (buf == 0) { return 0 - 1; }             # 1.16.2: checked
    var written = 0;
    var stop = 0;

    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    var pcap = _dp_pcap(row_sz);
    while (cur != 0) {
        hops = hops + 1;
        if (hops > maxhops) { stop = 1; }
        if (stop == 0) {
            page_read(fd, cur, buf);
            var nrows = _dp_nrows_cap(buf, pcap);
            if (written + nrows > cap) { nrows = cap - written; }
            if (nrows > 0) {
                memcpy(out + written * row_sz, buf + DP_DATA, nrows * row_sz);
                written = written + nrows;
            }
            if (written >= cap) { stop = 1; }
            cur = load64(buf + DP_NEXT);
        } else { cur = 0; }
    }

    pg_free(buf);
    return written;
}

# Rows in table `idx`'s data chain, counted page by page (1.16.2), or -1 when
# no page buffer can be had. TBL_NROWS is a running count that can read LOW:
# after a power loss in autocommit a data page can reach the disk ahead of the
# header that counts it. The callers that must not lose a row — ALTER's
# staging, and a scan whose buffer was sized from TBL_NROWS — count here. Each
# page's count is clamped as the readers clamp it.
fn tbl_chain_rows(fd, hdr, idx, row_sz): i64 {
    var entry = _tbl_entry(hdr, idx);
    var cur = load64(entry + TBL_ROOT);
    var buf = pg_alloc();
    if (buf == 0) { return 0 - 1; }
    var total = 0;
    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    while (cur != 0) {
        hops = hops + 1;
        if (hops > maxhops) { cur = 0; continue; }
        page_read(fd, cur, buf);
        total = total + _dp_nrows_clamped(buf, row_sz);
        cur = load64(buf + DP_NEXT);
    }
    pg_free(buf);
    return total;
}

# Take back the row tbl_insert just appended at `ref` (1.16.2), for a statement
# whose index update failed after the row was stored: the row would otherwise
# be in the table and missing from its index, which index lookups trust. Only
# the last row of its page can be taken back, which is where tbl_insert puts it.
# Returns PATRA_OK, or an error when the page could not be rewritten (the row
# then stays).
fn tbl_unappend(fd, hdr, idx, ref, row_sz): i64 {
    var pg = _bt_ref_pg(ref);
    var slot = _bt_ref_slot(ref);
    var buf = _pt_scratch_page();
    if (buf == 0) { return PATRA_ERR_IO; }
    var r = page_read_checked(fd, hdr, pg, buf);
    if (r == PATRA_OK) {
        if (_dp_nrows_clamped(buf, row_sz) != slot + 1) { r = PATRA_ERR_PAGE; }
    }
    if (r == PATRA_OK) {
        store64(buf + DP_NROWS, slot);
        r = page_write(fd, pg, buf);
    }
    _pt_scratch_free(buf);
    if (r != PATRA_OK) { return r; }
    var entry = _tbl_entry(hdr, idx);
    var rc = load64(entry + TBL_NROWS) - 1;
    if (rc < 0) { rc = 0; }
    store64(entry + TBL_NROWS, rc);
    return PATRA_OK;
}

# Filtered scan — copies matching rows into out, up to `cap`. Returns the
# count. 1.16.2: when a matching row did not fit, stores 1 at `ovf` (if not 0)
# — the caller sized `cap` from TBL_NROWS, which can read low, and a full
# buffer used to end the scan silently short.
fn tbl_scan_where(fd, hdr, idx, out, row_sz, schema, ncols, pr, cap, ovf): i64 {
    var entry = _tbl_entry(hdr, idx);
    var cur = load64(entry + TBL_ROOT);
    var buf = pg_alloc();
    # 1.16.2: checked; -1, not an empty result, so the query fails.
    if (buf == 0) { return 0 - 1; }
    var kept = 0;
    var pcap = _dp_pcap(row_sz);

    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    while (cur != 0) {
        # 1.14.0: bounded chain walk — a cyclic DP_NEXT otherwise hangs this
        # statement with its flock held. See tbl_drop.
        hops = hops + 1;
        if (hops > maxhops) { cur = 0; continue; }
        page_read(fd, cur, buf);
        var nrows = _dp_nrows_cap(buf, pcap);
        for (var i = 0; i < nrows; i = i + 1) {
            # `kept` is bounded by the caller's capacity, never by TBL_NROWS.
            # The result buffer is sized from the table directory's TBL_NROWS
            # while this loop was bounded only by the sum of per-page DP_NROWS,
            # and nothing reconciled the two. (audit 2026-08-18 S0-5)
            var rptr = buf + DP_DATA + i * row_sz;
            if (where_eval(rptr, schema, ncols, pr)) {
                if (kept < cap) {
                    memcpy(out + kept * row_sz, rptr, row_sz);
                    kept = kept + 1;
                } else {
                    if (ovf != 0) { store64(ovf, 1); }
                }
            }
        }
        cur = load64(buf + DP_NEXT);
    }

    pg_free(buf);
    return kept;
}

# Free the TEXT chain heads in `heads` (n words; 0 = none). 1.16.2, tbl_update.
fn _tbl_free_heads(fd, hdr, heads, n): i64 {
    for (var h = 0; h < n; h = h + 1) {
        var pg = load64(heads + h * 8);
        if (pg != 0) { _bytes_free_chain(fd, hdr, pg); }
    }
    return 0;
}

# Update matching rows in-place. Returns PATRA_OK or error.
# Update matching rows in-place
fn tbl_update(fd, hdr, idx, row_sz, schema, ncols, pr): i64 {
    var entry = _tbl_entry(hdr, idx);
    var cur = load64(entry + TBL_ROOT);
    var buf = pg_alloc();
    if (buf == 0) { return PATRA_ERR_IO; }      # 1.16.2: checked
    var nsets = load64(pr + PR_COUNT);
    var naff = 0;
    _tbl_rows_affected_set(0);

    # WHERE conditions are type-checked before any row is touched, same as the
    # SET list below. (audit 2026-08-18 S2-7)
    var wvu = where_validate_types(schema, ncols, pr);
    if (wvu != PATRA_OK) { pg_free(buf); return wvu; }

    # Validate every SET value's type against its column BEFORE touching a row.
    # Done up-front, not mid-loop, so a bad statement cannot leave a partial
    # update behind. Without this a STR value assigned to an INT column falls
    # through to row_write_str, whose unconditional
    # memset(row + off, 0, COL_STR_SZ) writes 256 bytes at an 8-byte offset —
    # destroying every following column — and still returns PATRA_OK.
    # (audit 2026-08-18 S0-2)
    for (var vs = 0; vs < nsets; vs = vs + 1) {
        var vset = pr + PR_ITEMS + vs * SET_SZ;
        var vci = _wh_resolve_col(schema, ncols,
          load64(vset + SET_CPTR), load64(vset + SET_CLEN));
        if (vci < 0) { pg_free(buf); return PATRA_ERR_NOTFOUND; }
        var vct = load64(schema + SCH_START + vci * SCH_ENTRY_SZ + SCH_CTYPE);
        var vvt = load64(vset + SET_VTYPE);
        # BYTES is programmatic-only; TEXT takes string literals only.
        if (vct == COL_BYTES) { pg_free(buf); return PATRA_ERR_TYPE; }
        if (vct == COL_TEXT) {
            if (vvt != COL_STR) { pg_free(buf); return PATRA_ERR_TYPE; }
        }
        if (vct == COL_INT) {
            if (vvt != COL_INT) { pg_free(buf); return PATRA_ERR_TYPE; }
        }
        if (vct == COL_STR) {
            if (vvt != COL_STR) { pg_free(buf); return PATRA_ERR_TYPE; }
            # A STR slot holds COL_STR_SZ - 1 bytes plus a NUL; silently
            # truncating made distinct values collide. (audit 2026-08-18 S2-8)
            if (load64(vset + SET_SLEN) > COL_STR_SZ - 1) {
                pg_free(buf);
                return PATRA_ERR_ROWSZ;
            }
        }
    }

    # Check if indexed column is being updated
    var uic = load64(schema + SCH_IDX_COL);
    var uir = load64(schema + SCH_IDX_ROOT);
    var uioff = 0;
    var ui_updating = 0;
    if (uic >= 0) {
        if (uic < ncols) {
            uioff = row_field_offset(schema, ncols, uic);
            var icn = schema + SCH_START + uic * SCH_ENTRY_SZ + SCH_CNAME;
            var icnl = strlen(icn);
            for (var s = 0; s < nsets; s = s + 1) {
                var set = pr + PR_ITEMS + s * SET_SZ;
                if (load64(set + SET_CLEN) == icnl) {
                    if (memeq(load64(set + SET_CPTR), icn, icnl)) {
                        ui_updating = 1;
                    }
                }
            }
        } else { uic = 0 - 1; }
    }

    var uheads[128];     # per SET item (MAX_SET_ITEMS 15): its new TEXT chain
    var uolds[128];      # and the chain it replaces
    # Each SET item's column — type and row offset — resolved once here, not
    # by name for every matching row (1.16.2; validated above, so it exists).
    var utyp[128];
    var uoff[128];
    for (var s0 = 0; s0 < nsets; s0 = s0 + 1) {
        var set0 = pr + PR_ITEMS + s0 * SET_SZ;
        var c0 = _wh_resolve_col(schema, ncols,
          load64(set0 + SET_CPTR), load64(set0 + SET_CLEN));
        store64(&utyp + s0 * 8, load64(schema + SCH_START + c0 * SCH_ENTRY_SZ + SCH_CTYPE));
        store64(&uoff + s0 * 8, row_field_offset(schema, ncols, c0));
    }
    var ufail = 0;
    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    while (cur != 0) {
        # 1.14.0: bounded chain walk — a cyclic DP_NEXT otherwise hangs this
        # statement with its flock held. See tbl_drop.
        hops = hops + 1;
        if (hops > maxhops) { cur = 0; continue; }
        page_read(fd, cur, buf);
        var nrows = _dp_nrows_clamped(buf, row_sz);
        var modified = 0;

        for (var i = 0; i < nrows; i = i + 1) {
            var rptr = buf + DP_DATA + i * row_sz;
            # A failure stops the update: no later row on the page is touched.
            # Tested only on a match, so the scan of the rest costs what it did.
            if (where_eval(rptr, schema, ncols, pr)) {
                if (ufail == 0) {
                    # 1.16.2: every new TEXT chain this row needs is written first,
                    # before anything about the row changes. The old chain used to
                    # be freed and the new one written after, unchecked, so a
                    # refused write left the row naming freed pages. If one is
                    # refused, the chains already written for this row are given
                    # back, the row stays as it was, and the update stops.
                    var uok = 1;
                    for (var s1 = 0; s1 < nsets; s1 = s1 + 1) {
                        store64(&uheads + s1 * 8, 0);
                        if (uok == 1) {
                            if (load64(&utyp + s1 * 8) == COL_TEXT) {
                                var set1 = pr + PR_ITEMS + s1 * SET_SZ;
                                var l1 = load64(set1 + SET_SLEN);
                                var h1 = _bytes_write_chain(fd, hdr, load64(set1 + SET_SPTR), l1);
                                if (l1 > 0) { if (h1 == 0) { uok = 0; } }
                                store64(&uheads + s1 * 8, h1);
                            }
                        }
                    }
                    # The row is copied before it changes, so a refused index
                    # insert can put it back.
                    var ucopy = 0;
                    if (uok == 1) {
                        if (ui_updating != 0) {
                            if (uir != 0) {
                                ucopy = _pt_scratch_page();
                                if (ucopy == 0) { uok = 0; }
                            }
                        }
                    }
                    if (uok == 0) {
                        _tbl_free_heads(fd, hdr, &uheads, nsets);
                        ufail = PATRA_ERR_IO;
                    } else {
                        var old_key = 0;
                        if (ucopy != 0) {
                            memcpy(ucopy, rptr, row_sz);
                            old_key = _idx_key_from_row(schema, ncols, uic, rptr);
                        }
                        for (var s = 0; s < nsets; s = s + 1) {
                            var set = pr + PR_ITEMS + s * SET_SZ;
                            var ctype = load64(&utyp + s * 8);
                            var coff = load64(&uoff + s * 8);
                            store64(&uolds + s * 8, 0);
                            if (ctype == COL_TEXT) {
                                # The old chain is freed once the row is final —
                                # read here, per SET, so a column set twice frees
                                # the first new chain rather than the old one twice.
                                store64(&uolds + s * 8, row_read_bytes_page(rptr, coff));
                                row_write_bytes_ref(rptr, coff, load64(&uheads + s * 8), load64(set + SET_SLEN));
                            } elif (load64(set + SET_VTYPE) == COL_INT) {
                                row_write_int(rptr, coff, load64(set + SET_IVAL));
                            } else {
                                row_write_str(rptr, coff, load64(set + SET_SPTR), load64(set + SET_SLEN));
                            }
                        }
                        # The new index entry goes in before the old one comes out:
                        # an insert can be refused (it allocates, and can split), a
                        # removal cannot (_bt_spare). A refused insert restores the
                        # row and gives its new chains back.
                        if (ucopy != 0) {
                            var new_key = _idx_key_from_row(schema, ncols, uic, rptr);
                            if (new_key != old_key) {
                                var ref = _bt_mkref(cur, i);
                                uir = btree_insert(fd, hdr, uir, new_key, ref);
                                store64(schema + SCH_IDX_ROOT, uir);
                                if (_bt_err_get() != 0) {
                                    memcpy(rptr, ucopy, row_sz);
                                    uok = 0;
                                } else {
                                    btree_remove_ref(fd, hdr, uir, old_key, ref);
                                    if (_bt_err_get() != 0) { ufail = PATRA_ERR_IO; }
                                }
                            }
                            _pt_scratch_free(ucopy);
                        }
                        if (uok == 0) {
                            _tbl_free_heads(fd, hdr, &uheads, nsets);
                            ufail = PATRA_ERR_IO;
                        } else {
                            _tbl_free_heads(fd, hdr, &uolds, nsets);
                            modified = 1;
                            naff = naff + 1;
                        }
                    }
                }
            }
        }

        # Rows already updated on this page are written even after a failure:
        # their old chains are freed and their new ones are live.
        if (modified != 0) { page_write(fd, cur, buf); }
        cur = load64(buf + DP_NEXT);
        if (ufail != 0) { cur = 0; }
    }

    pg_free(buf);
    _tbl_rows_affected_set(naff);
    return ufail;
}

# Delete matching rows with page compaction. Returns PATRA_OK.
# Delete matching rows with page compaction
fn tbl_delete(fd, hdr, idx, row_sz, schema, ncols, pr): i64 {
    var wvd = where_validate_types(schema, ncols, pr);
    if (wvd != PATRA_OK) { return wvd; }
    var entry = _tbl_entry(hdr, idx);
    var cur = load64(entry + TBL_ROOT);
    var buf = pg_alloc();
    var prevbuf = pg_alloc();
    # 1.16.2: checked, before any row is touched.
    if (buf == 0) { pg_free(prevbuf); return PATRA_ERR_IO; }
    if (prevbuf == 0) { pg_free(buf); return PATRA_ERR_IO; }
    var prev = 0;
    var deleted = 0;
    var derr = 0;

    # Check for B-tree index
    var dic = load64(schema + SCH_IDX_COL);
    var dir = load64(schema + SCH_IDX_ROOT);
    var doff = 0;
    if (dic >= 0) {
        if (dic < ncols) {
            doff = row_field_offset(schema, ncols, dic);
        } else {
            dic = 0 - 1;
        }
    }

    var hops = 0;
    var maxhops = load64(hdr + HDR_PGCOUNT);
    if (maxhops < 1) { maxhops = 1; }
    while (cur != 0) {
        # 1.14.0: bounded chain walk — a cyclic DP_NEXT otherwise hangs this
        # statement with its flock held. See tbl_drop.
        hops = hops + 1;
        if (hops > maxhops) { cur = 0; continue; }
        page_read(fd, cur, buf);
        var nrows = _dp_nrows_clamped(buf, row_sz);
        var kept = 0;

        for (var i = 0; i < nrows; i = i + 1) {
            var rptr = buf + DP_DATA + i * row_sz;
            if (where_eval(rptr, schema, ncols, pr)) {
                # Free any BLOB chains this row owned before the row slot
                # gets reclaimed or overwritten by the compaction below.
                _tbl_free_row_bytes(fd, hdr, rptr, schema, ncols);
                # Invalidate B-tree entry
                if (dic >= 0) {
                    if (dir != 0) {
                        var dkey = _idx_key_from_row(schema, ncols, dic, rptr);
                        var dref = _bt_mkref(cur, i);
                        btree_remove_ref(fd, hdr, dir, dkey, dref);
                        if (_bt_err_get() != 0) { derr = 1; }
                    }
                }
                deleted = deleted + 1;
            } else {
                if (kept != i) {
                    # The survivor moves down a slot. Its index entry must move
                    # with it — a (page, slot) ref left naming the old slot is
                    # how DELETE silently desynced the index from the rows.
                    # Repoint BEFORE the memcpy, while rptr still holds the row
                    # at its old address. (audit 2026-08-18 S2-4)
                    if (dic >= 0) {
                        if (dir != 0) {
                            var mkey = _idx_key_from_row(schema, ncols, dic, rptr);
                            btree_update_ref(fd, hdr, dir, mkey,
                              _bt_mkref(cur, i), _bt_mkref(cur, kept));
                            if (_bt_err_get() != 0) { derr = 1; }
                        }
                    }
                    memcpy(buf + DP_DATA + kept * row_sz, rptr, row_sz);
                }
                kept = kept + 1;
            }
        }

        var next = load64(buf + DP_NEXT);

        # v1.13.9: a data page that has just lost its last row is unlinked and
        # returned to the free list.
        #
        # Before this, an emptied page was written back with DP_NROWS = 0 and
        # left in the chain forever, so a table's file grew with the number of
        # rows EVER inserted rather than the number live. sit measured ~0.57 KB
        # per insert reclaimed-never across three delete patterns, and a staging
        # index that reached 277 MB holding 1,000 live rows. The free list
        # itself already existed and worked — `page_alloc` pops from it,
        # `page_free` pushes, and bytes.cyr / btree.cyr both use it. Only the
        # row-delete path never did. (sit report, 2026-08-19, second finding.)
        #
        # The ROOT page is kept even when empty: `TBL_ROOT == 0` means "this
        # table has no data page at all", which tbl_create refuses to register
        # and the insert path treats as corrupt. Freeing it would turn an empty
        # table into a broken one. A table that churns N pages therefore
        # reclaims N-1 of them, and the survivor is reused by the next insert.
        var freed = 0;
        if (kept == 0) {
            if (prev != 0) {
                page_read(fd, prev, prevbuf);
                store64(prevbuf + DP_NEXT, next);
                page_write(fd, prev, prevbuf);
                page_free(fd, hdr, cur);
                freed = 1;
            }
        }
        if (freed == 0) {
            if (kept != nrows) {
                store64(buf + DP_NROWS, kept);
                page_write(fd, cur, buf);
            }
            prev = cur;
        }
        cur = next;
    }

    # 1.16.2: never below zero. After a power loss in autocommit a data page
    # can reach the disk ahead of the header that counts it, so the count can
    # read low; `rc - deleted` then went negative, and patra_hdr_verify —
    # which since 1.16.2 runs on every statement — refuses a negative count.
    var rc = load64(entry + TBL_NROWS) - deleted;
    if (rc < 0) { rc = 0; }
    store64(entry + TBL_NROWS, rc);
    _tbl_rows_affected_set(deleted);

    pg_free(prevbuf);
    pg_free(buf);
    # 1.16.2: an index entry that could not be removed or repointed. Not for
    # want of memory in autocommit (btree.cyr _bt_spare); the delete itself is
    # complete, and inside a transaction the error makes commit roll it back.
    if (derr != 0) { return PATRA_ERR_IO; }
    return PATRA_OK;
}
