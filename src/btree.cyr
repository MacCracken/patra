# btree.cyr — B+ tree index (order 64, keys are i64)

enum BtConst {
    BTREE_ORDER = 64;
    BT_MAX_KEYS = 63;
    BT_MAX_DEPTH = 10;
}

enum BtOff {
    BT_TYPE = 0;
    BT_LEAF = 8;
    BT_NKEYS = 16;
    BT_KEYS = 24;
    BT_VALS = 528;
}
# Keys: 63 × 8 = 504 bytes at offset 24–527
# Vals:  leaf: 63 × 8 = 504 bytes at 528–1031
#        int:  64 × 8 = 512 bytes at 528–1039

# Schema page index info
enum SchIdx {
    SCH_AUTOINC_COL = 4072;
    SCH_IDX_COL = 4080;
    SCH_IDX_ROOT = 4088;
}

# Row reference encoding: page * 65536 + slot
fn _bt_mkref(pg, slot): i64 { return pg * 65536 + slot; }
fn _bt_ref_pg(ref): i64 { return ref / 65536; }
fn _bt_ref_slot(ref): i64 { return ref % 65536; }

# Resolve a row ref's slot against the data page it landed on, returning a
# pointer to the row or 0 if the slot does not name a live row.
#
# Both halves of a ref (page, slot) come off a B-tree leaf on disk, so both are
# attacker-controllable in a malformed .patra file. A ref of 0x000000010000FFFF
# yields slot 65535, and with rsz = 256 that addressed ~16 MB past a 4 KB page
# buffer — read by where_eval and, on a match, memcpy'd into the result set the
# caller receives. Callers must pair this with page_read_checked for the page
# half. (audit 2026-08-18 S1-6)
fn _bt_row_ptr(buf, rsl, rsz): i64 {
    if (rsl < 0) { return 0; }
    if (rsz <= 0) { return 0; }
    var nr = load64(buf + DP_NROWS);
    # DP_NROWS is equally untrusted: cap it at what the page can physically hold.
    var cap = (PAGE_SIZE - DP_DATA) / rsz;
    if (nr > cap) { nr = cap; }
    if (rsl >= nr) { return 0; }
    return buf + DP_DATA + rsl * rsz;
}

# Path stack for insert (max depth BT_MAX_DEPTH = 10)
var _bt_path[80];
var _bt_pdepth = 0;

# ── Create ────────────────────

# Create empty B-tree (single leaf root), returns page number
fn btree_create(fd, hdr): i64 {
    var pg = page_alloc(fd, hdr);
    var buf = pg_alloc();
    memset(buf, 0, PAGE_SIZE);
    store64(buf + BT_TYPE, PAGE_BTREE);
    store64(buf + BT_LEAF, 1);
    page_write(fd, pg, buf);
    pg_free(buf);
    return pg;
}

# ── Find leaf (records path) ────────────────────

fn _bt_find_leaf(fd, hdr, root, key): i64 {
    _bt_pdepth = 0;
    var pg = root;
    var buf = pg_alloc();
    page_read(fd, pg, buf);

    while (load64(buf + BT_LEAF) == 0) {
        if (_bt_pdepth >= BT_MAX_DEPTH) {
            # Depth cap reached: malformed tree or a cycle. Returning the
            # current page used to be described as harmless ("the caller's
            # key-match logic will find nothing") — but the caller is
            # btree_insert, which writes LEAF structure into whatever it gets
            # back, corrupting an internal node. 0 is never a valid B-tree
            # page, so it is an unambiguous failure signal.
            # (audit 2026-08-18 S2-6)
            pg_free(buf);
            return 0;
        }
        store64(&_bt_path + _bt_pdepth * 8, pg);
        _bt_pdepth = _bt_pdepth + 1;
        var nk = load64(buf + BT_NKEYS);
        if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
        var ci = nk;
        var ff = 0;
        for (var i = 0; i < nk; i = i + 1) {
            if (ff == 0) {
                if (key < load64(buf + BT_KEYS + i * 8)) {
                    ci = i;
                    ff = 1;
                }
            }
        }
        pg = load64(buf + BT_VALS + ci * 8);
        if (page_read_checked(fd, hdr, pg, buf) != PATRA_OK) {
            # Child is out of range or unreadable. `root` was returned here,
            # which is itself an internal node in any tree deeper than one
            # level — same corruption as above. (audit 2026-08-18 S2-6)
            pg_free(buf);
            return 0;
        }
    }
    store64(&_bt_path + _bt_pdepth * 8, pg);
    _bt_pdepth = _bt_pdepth + 1;
    pg_free(buf);
    return pg;
}

# ── Insert into non-full leaf ────────────────────

fn _bt_leaf_ins(buf, key, val): i64 {
    var nk = load64(buf + BT_NKEYS);
    # CLAMP: BT_NKEYS is read off a disk page, so a torn write or a hostile
    # file controls it. Every *reader* clamped; the mutation paths did not,
    # and used it as a loop bound while filling fixed-size buffers.
    # (audit 2026-08-18 S1-5)
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var pos = nk;
    var ff = 0;
    for (var i = 0; i < nk; i = i + 1) {
        if (ff == 0) {
            if (key <= load64(buf + BT_KEYS + i * 8)) {
                pos = i;
                ff = 1;
            }
        }
    }
    var j = nk - 1;
    while (j >= pos) {
        store64(buf + BT_KEYS + (j + 1) * 8, load64(buf + BT_KEYS + j * 8));
        store64(buf + BT_VALS + (j + 1) * 8, load64(buf + BT_VALS + j * 8));
        j = j - 1;
    }
    store64(buf + BT_KEYS + pos * 8, key);
    store64(buf + BT_VALS + pos * 8, val);
    store64(buf + BT_NKEYS, nk + 1);
}

# ── Insert into non-full internal ──────────

fn _bt_int_ins(buf, key, rchild): i64 {
    var nk = load64(buf + BT_NKEYS);
    # CLAMP: BT_NKEYS is read off a disk page, so a torn write or a hostile
    # file controls it. Every *reader* clamped; the mutation paths did not,
    # and used it as a loop bound while filling fixed-size buffers.
    # (audit 2026-08-18 S1-5)
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var pos = nk;
    var ff = 0;
    for (var i = 0; i < nk; i = i + 1) {
        if (ff == 0) {
            if (key < load64(buf + BT_KEYS + i * 8)) {
                pos = i;
                ff = 1;
            }
        }
    }
    var j = nk - 1;
    while (j >= pos) {
        store64(buf + BT_KEYS + (j + 1) * 8, load64(buf + BT_KEYS + j * 8));
        j = j - 1;
    }
    store64(buf + BT_KEYS + pos * 8, key);
    j = nk;
    while (j >= pos + 1) {
        store64(buf + BT_VALS + (j + 1) * 8, load64(buf + BT_VALS + j * 8));
        j = j - 1;
    }
    store64(buf + BT_VALS + (pos + 1) * 8, rchild);
    store64(buf + BT_NKEYS, nk + 1);
}

# ── Push separator to parent ───────────────

fn _bt_push_up(fd, hdr, root, left_pg, sep, right_pg): i64 {
    if (_bt_pdepth <= 1) {
        # left_pg is the root — create new root
        var nr = page_alloc(fd, hdr);
        var nb = pg_alloc();
        memset(nb, 0, PAGE_SIZE);
        store64(nb + BT_TYPE, PAGE_BTREE);
        store64(nb + BT_LEAF, 0);
        store64(nb + BT_NKEYS, 1);
        store64(nb + BT_KEYS, sep);
        store64(nb + BT_VALS, left_pg);
        store64(nb + BT_VALS + 8, right_pg);
        page_write(fd, nr, nb);
        pg_free(nb);
        return nr;
    }

    var par_pg = load64(&_bt_path + (_bt_pdepth - 2) * 8);
    var pb = pg_alloc();
    page_read(fd, par_pg, pb);
    var nk = load64(pb + BT_NKEYS);
    # CLAMP: BT_NKEYS is read off a disk page, so a torn write or a hostile
    # file controls it. Every *reader* clamped; the mutation paths did not,
    # and used it as a loop bound while filling fixed-size buffers.
    # (audit 2026-08-18 S1-5)
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }

    if (nk < BT_MAX_KEYS) {
        _bt_int_ins(pb, sep, right_pg);
        page_write(fd, par_pg, pb);
        pg_free(pb);
        return root;
    }

    # Parent full — split internal node
    var tk = _pt_alloc(520);
    var tc = _pt_alloc(528);

    # Find position for sep
    var pos = nk;
    var ff = 0;
    for (var i = 0; i < nk; i = i + 1) {
        if (ff == 0) {
            if (sep < load64(pb + BT_KEYS + i * 8)) {
                pos = i;
                ff = 1;
            }
        }
    }

    # Build temp keys (64)
    var ti = 0;
    for (var i = 0; i < nk; i = i + 1) {
        if (i == pos) {
            store64(tk + ti * 8, sep);
            ti = ti + 1;
        }
        store64(tk + ti * 8, load64(pb + BT_KEYS + i * 8));
        ti = ti + 1;
    }
    if (pos == nk) { store64(tk + ti * 8, sep); ti = ti + 1; }

    # Build temp children (65)
    ti = 0;
    for (var i = 0; i <= nk; i = i + 1) {
        store64(tc + ti * 8, load64(pb + BT_VALS + i * 8));
        ti = ti + 1;
        if (i == pos) {
            store64(tc + ti * 8, right_pg);
            ti = ti + 1;
        }
    }

    # Split: left [0..30] (31 keys, 32 children), mid=31, right [32..63] (32 keys, 33 children)
    var mid = 31;
    var mid_key = load64(tk + mid * 8);

    # Left stays in par_pg
    store64(pb + BT_NKEYS, mid);
    for (var i = 0; i < mid; i = i + 1) {
        store64(pb + BT_KEYS + i * 8, load64(tk + i * 8));
    }
    for (var i = 0; i <= mid; i = i + 1) {
        store64(pb + BT_VALS + i * 8, load64(tc + i * 8));
    }
    page_write(fd, par_pg, pb);

    # Right in new page
    var rpg = page_alloc(fd, hdr);
    var rnk = 64 - mid - 1;
    memset(pb, 0, PAGE_SIZE);
    store64(pb + BT_TYPE, PAGE_BTREE);
    store64(pb + BT_LEAF, 0);
    store64(pb + BT_NKEYS, rnk);
    for (var i = 0; i < rnk; i = i + 1) {
        store64(pb + BT_KEYS + i * 8, load64(tk + (mid + 1 + i) * 8));
    }
    for (var i = 0; i <= rnk; i = i + 1) {
        store64(pb + BT_VALS + i * 8, load64(tc + (mid + 1 + i) * 8));
    }
    page_write(fd, rpg, pb);

    _pt_free(tk);
    _pt_free(tc);
    pg_free(pb);

    _bt_pdepth = _bt_pdepth - 1;
    return _bt_push_up(fd, hdr, root, par_pg, mid_key, rpg);
}

# ── Insert ────────────────────

# Insert key-value into B-tree, returns (possibly new) root
fn btree_insert(fd, hdr, root, key, val): i64 {
    var leaf_pg = _bt_find_leaf(fd, hdr, root, key);
    # Descent failed (depth cap or an unreadable child): drop the index entry
    # rather than write leaf structure over an internal node. The row itself is
    # still stored; a scan finds it.
    if (leaf_pg == 0) { return root; }
    var buf = pg_alloc();
    if (page_read_checked(fd, hdr, leaf_pg, buf) != PATRA_OK) {
        pg_free(buf);
        return root;
    }
    # Belt and braces: only ever mutate an actual leaf.
    if (load64(buf + BT_LEAF) == 0) {
        pg_free(buf);
        return root;
    }
    var nk = load64(buf + BT_NKEYS);
    # CLAMP: BT_NKEYS is read off a disk page, so a torn write or a hostile
    # file controls it. Every *reader* clamped; the mutation paths did not,
    # and used it as a loop bound while filling fixed-size buffers.
    # (audit 2026-08-18 S1-5)
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }

    if (nk < BT_MAX_KEYS) {
        _bt_leaf_ins(buf, key, val);
        page_write(fd, leaf_pg, buf);
        pg_free(buf);
        return root;
    }

    # Leaf full — build sorted temp (64 entries)
    var tk = _pt_alloc(520);
    var tv = _pt_alloc(520);
    var ins = 0;
    var ff = 0;
    for (var i = 0; i < nk; i = i + 1) {
        if (ff == 0) {
            if (key <= load64(buf + BT_KEYS + i * 8)) {
                store64(tk + ins * 8, key);
                store64(tv + ins * 8, val);
                ins = ins + 1;
                ff = 1;
            }
        }
        store64(tk + ins * 8, load64(buf + BT_KEYS + i * 8));
        store64(tv + ins * 8, load64(buf + BT_VALS + i * 8));
        ins = ins + 1;
    }
    if (ff == 0) {
        store64(tk + ins * 8, key);
        store64(tv + ins * 8, val);
        ins = ins + 1;
    }

    var split = 32;
    var sep = load64(tk + split * 8);

    # Left half stays in leaf_pg
    store64(buf + BT_NKEYS, split);
    for (var i = 0; i < split; i = i + 1) {
        store64(buf + BT_KEYS + i * 8, load64(tk + i * 8));
        store64(buf + BT_VALS + i * 8, load64(tv + i * 8));
    }
    page_write(fd, leaf_pg, buf);

    # Right half in new page
    var rpg = page_alloc(fd, hdr);
    memset(buf, 0, PAGE_SIZE);
    store64(buf + BT_TYPE, PAGE_BTREE);
    store64(buf + BT_LEAF, 1);
    var rn = 64 - split;
    store64(buf + BT_NKEYS, rn);
    for (var i = 0; i < rn; i = i + 1) {
        store64(buf + BT_KEYS + i * 8, load64(tk + (split + i) * 8));
        store64(buf + BT_VALS + i * 8, load64(tv + (split + i) * 8));
    }
    page_write(fd, rpg, buf);

    _pt_free(tk);
    _pt_free(tv);
    pg_free(buf);

    return _bt_push_up(fd, hdr, root, leaf_pg, sep, rpg);
}

# ── Search (all refs for key) ──────────────

# Search for all refs matching key
fn btree_search(fd, hdr, root, key, out, max): i64 {
    return _bt_range(fd, hdr, root, key, key, out, max);
}

# ── Range scan [lo, hi] — collects refs into out ────────────

fn _bt_range(fd, hdr, root, lo, hi, out, max): i64 {
    var cnt = 0;
    _bt_rwalk(fd, hdr, root, lo, hi, out, max, &cnt, 0);
    return cnt;
}

fn _bt_rwalk(fd, hdr, pg, lo, hi, out, max, cp, depth): i64 {
    if (depth >= BT_MAX_DEPTH) { return 0; }
    var buf = pg_alloc();
    if (page_read_checked(fd, hdr, pg, buf) != PATRA_OK) {
        pg_free(buf);
        return 0;
    }
    var nk = load64(buf + BT_NKEYS);
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var leaf = load64(buf + BT_LEAF);

    if (leaf != 0) {
        for (var i = 0; i < nk; i = i + 1) {
            var c = load64(cp);
            if (c < max) {
                var k = load64(buf + BT_KEYS + i * 8);
                if (k >= lo) {
                    if (k <= hi) {
                        store64(out + c * 8, load64(buf + BT_VALS + i * 8));
                        store64(cp, c + 1);
                    }
                }
            }
        }
    } else {
        # Find first relevant child
        var first = 0;
        for (var i = 0; i < nk; i = i + 1) {
            if (load64(buf + BT_KEYS + i * 8) < lo) {
                first = i + 1;
            }
        }
        var stop = 0;
        for (var i = first; i <= nk; i = i + 1) {
            if (stop == 0) {
                if (load64(cp) < max) {
                    _bt_rwalk(fd, hdr, load64(buf + BT_VALS + i * 8),
                      lo, hi, out, max, cp, depth + 1);
                    if (i < nk) {
                        if (load64(buf + BT_KEYS + i * 8) > hi) {
                            stop = 1;
                        }
                    }
                }
            }
        }
    }
    pg_free(buf);
    return 0;
}

# ── Remove ref (lazy delete — set value to 0) ──────────────

# Lazy-delete: invalidate a specific ref for a key
# ── Ref mutation (remove / repoint) ────────────────────
#
# Both mutators must visit EVERY leaf that can hold `key`, not just one.
#
# A leaf split takes sep = tk[32] and pushes it up unchanged, so when a run of
# equal keys spans the split boundary, entries equal to sep stay in the LEFT
# leaf while _bt_find_leaf's strict `key < keys[i]` descent routes the key
# RIGHT. Reads were never affected — _bt_rwalk walks first-relevant-child
# through to the last child whose separator exceeds `hi`, so it sees both
# leaves — but the mutators used _bt_find_leaf and silently touched nothing.
# Measured before this change: 100 refs under one key, btree_remove_ref
# returned 0 (found nothing) and all 100 refs stayed live.
#
# Consequence was a stale index entry surviving a DELETE or an UPDATE of a
# duplicate key, and (since v1.13.5) a silently-skipped ref repointing.
# (audit 2026-08-18 S2-5)
#
# Descent mirrors _bt_rwalk exactly, so reads and mutations agree on which
# leaves can hold a key. Returns the number of entries changed.
fn _bt_mut_walk(fd, hdr, pg, key, oldref, newref, cp, depth): i64 {
    if (depth >= BT_MAX_DEPTH) { return 0; }
    var buf = pg_alloc();
    if (page_read_checked(fd, hdr, pg, buf) != PATRA_OK) {
        pg_free(buf);
        return 0;
    }
    var nk = load64(buf + BT_NKEYS);
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var leaf = load64(buf + BT_LEAF);

    if (leaf != 0) {
        var modified = 0;
        for (var i = 0; i < nk; i = i + 1) {
            if (load64(buf + BT_KEYS + i * 8) == key) {
                if (load64(buf + BT_VALS + i * 8) == oldref) {
                    store64(buf + BT_VALS + i * 8, newref);
                    modified = 1;
                    store64(cp, load64(cp) + 1);
                }
            }
        }
        if (modified != 0) { page_write(fd, pg, buf); }
    } else {
        # First child that can hold `key`, then onward while the separators
        # still allow it — the same rule _bt_rwalk uses with lo == hi == key.
        var first = 0;
        for (var i = 0; i < nk; i = i + 1) {
            if (load64(buf + BT_KEYS + i * 8) < key) {
                first = i + 1;
            }
        }
        var stop = 0;
        for (var i = first; i <= nk; i = i + 1) {
            if (stop == 0) {
                _bt_mut_walk(fd, hdr, load64(buf + BT_VALS + i * 8),
                  key, oldref, newref, cp, depth + 1);
                if (i < nk) {
                    if (load64(buf + BT_KEYS + i * 8) > key) { stop = 1; }
                }
            }
        }
    }
    pg_free(buf);
    return 0;
}

# Tombstone the (key, ref) entry. Lazy delete: the slot keeps its key and takes
# the -1 sentinel as its value.
fn btree_remove_ref(fd, hdr, root, key, ref): i64 {
    var n = 0;
    _bt_mut_walk(fd, hdr, root, key, ref, 0 - 1, &n, 0);
    return n;
}

# Repoint an existing (key, oldref) entry at newref, in place.
#
# DELETE compacts a data page by shifting survivors into lower slots, but a
# B-tree value is a (page, slot) pair — so every survivor that moved was left
# with an index entry naming the slot it used to occupy. Lookups then read the
# wrong slot, and correctness silently depended on reading past DP_NROWS.
#
# Deliberately an in-place rewrite rather than remove+insert: it touches no
# structure, cannot split, and cannot change the root — which matters because
# _exec_delete never writes the schema page back, so a new root would be lost.
# (audit 2026-08-18 S2-4)
fn btree_update_ref(fd, hdr, root, key, oldref, newref): i64 {
    var n = 0;
    _bt_mut_walk(fd, hdr, root, key, oldref, newref, &n, 0);
    return n;
}

# ── Whole-tree free (depth-first page reclaim) ─────────────

# Free every page in the B-tree rooted at `root` via depth-first recursion:
# leaves get freed directly; internal nodes recurse into children before
# freeing themselves. Prior to 1.5.0 only the root was freed, leaving all
# internal and leaf pages unreachable on DROP TABLE / ALTER ADD / ALTER DROP.
fn btree_free_all(fd, hdr, root): i64 {
    return _bt_free_walk(fd, hdr, root, 0);
}

fn _bt_free_walk(fd, hdr, root, depth): i64 {
    if (root == 0) { return 0; }
    if (depth >= BT_MAX_DEPTH) { return 0; }
    var buf = pg_alloc();
    if (page_read_checked(fd, hdr, root, buf) != PATRA_OK) {
        pg_free(buf);
        return 0;
    }
    var leaf = load64(buf + BT_LEAF);
    if (leaf != 0) {
        pg_free(buf);
        page_free(fd, hdr, root);
        return 0;
    }
    var nk = load64(buf + BT_NKEYS);
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    for (var i = 0; i <= nk; i = i + 1) {
        _bt_free_walk(fd, hdr, load64(buf + BT_VALS + i * 8), depth + 1);
    }
    pg_free(buf);
    page_free(fd, hdr, root);
    return 0;
}

# ── Compaction: reclaim lazy-deleted entries ──────────────

# Compact a single leaf in place: keep only entries with valid refs (val != -1).
# Shifts survivors forward, updates BT_NKEYS. Returns reclaimed count.
# Structural rebalancing (empty-leaf removal) is intentionally out of scope — roadmap.md
# future inserts into the leaf's key range will refill the slots. Tracked in
# docs/development/roadmap.md § Open backlog, "B-tree structural rebalancing".
fn _bt_leaf_compact(fd, pg): i64 {
    var buf = pg_alloc();
    page_read(fd, pg, buf);
    var nk = load64(buf + BT_NKEYS);
    # CLAMP: BT_NKEYS is read off a disk page, so a torn write or a hostile
    # file controls it. Every *reader* clamped; the mutation paths did not,
    # and used it as a loop bound while filling fixed-size buffers.
    # (audit 2026-08-18 S1-5)
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var kept = 0;
    for (var i = 0; i < nk; i = i + 1) {
        var v = load64(buf + BT_VALS + i * 8);
        if (v != (0 - 1)) {
            if (kept != i) {
                store64(buf + BT_KEYS + kept * 8, load64(buf + BT_KEYS + i * 8));
                store64(buf + BT_VALS + kept * 8, v);
            }
            kept = kept + 1;
        }
    }
    var reclaimed = nk - kept;
    if (reclaimed > 0) {
        store64(buf + BT_NKEYS, kept);
        page_write(fd, pg, buf);
    }
    pg_free(buf);
    return reclaimed;
}

# Depth-first walk: recurse into internal children, compact every leaf.
# Returns total reclaimed across all leaves.
fn _bt_compact_walk(fd, hdr, pg, depth): i64 {
    if (depth >= BT_MAX_DEPTH) { return 0; }
    var buf = pg_alloc();
    if (page_read_checked(fd, hdr, pg, buf) != PATRA_OK) {
        pg_free(buf);
        return 0;
    }
    var leaf = load64(buf + BT_LEAF);
    if (leaf != 0) {
        pg_free(buf);
        return _bt_leaf_compact(fd, pg);
    }
    var nk = load64(buf + BT_NKEYS);
    if (nk > BT_MAX_KEYS) { nk = BT_MAX_KEYS; }
    var total = 0;
    for (var i = 0; i <= nk; i = i + 1) {
        total = total + _bt_compact_walk(fd, hdr,
          load64(buf + BT_VALS + i * 8),
          depth + 1);
    }
    pg_free(buf);
    return total;
}

# Reclaim all tombstoned (lazy-deleted) entries in the tree. Safe to call
# concurrently with nothing (caller holds write lock). Returns count reclaimed.
fn btree_compact(fd, hdr, root): i64 {
    return _bt_compact_walk(fd, hdr, root, 0);
}
