# file.cyr — .patra file format constants, header, flock locking

# ── Constants ────────────────────

enum PageConst { PAGE_SIZE = 4096; MAX_TABLES = 63; MAX_COLS = 32; }

# Upper bound on how many pages one chain walk may visit (1.14.0). Every data-
# page and chain-page walk follows a `next` link read straight off disk, so a
# crafted or torn file can make the chain cyclic — and those walks run inside
# the statement's flock window, so a cycle hangs every other process on the
# file. Walks that have the header use HDR_PGCOUNT, which is exact; this is the
# fallback for the few that do not, and corresponds to page_offset's own
# ceiling, so it can never reject a chain a valid file could contain.
enum ChainBound { MAX_CHAIN_PAGES = 1125899906842624; }

# Ceiling on how many index refs an INSERT OR IGNORE probe will collect for one
# key before giving up and reporting that it cannot decide (1.14.0). 65,536 refs
# is a 512 KB buffer — far past any real key's live duplicates plus tombstones,
# and bounded so a hostile file cannot drive an unbounded allocation.
enum IdxProbe { IDX_PROBE_MAX = 65536; }

# Magic: "PTRA" as little-endian u32 (P=0x50 T=0x54 R=0x52 A=0x41)
enum PatraFmt { PATRA_MAGIC = 0x41525450; PATRA_VER = 1; }

enum PageType  { PAGE_FREE = 0; PAGE_DATA = 1; PAGE_SCHEMA = 2; PAGE_BTREE = 3; PAGE_BYTES = 4; }
# COL_TEXT is variable-length text: SQL-writable (string literals), stored in
# the same chain-page infra as COL_BYTES (16-byte (page,len) row ref). The two
# differ only at the SQL surface — TEXT accepts INSERT/UPDATE string literals
# and SELECT returns its content; BYTES stays binary / programmatic-only. Both
# forbid WHERE and indexing (variable-length isn't comparable/hashable).
# COL_PARAM is a parse-time marker for a `?` bind placeholder — never stored on
# disk. The parser stamps it on the INSERT/WHERE/UPDATE value slot and records
# the bind index; _apply_binds rewrites it to the bound value's real type
# (COL_INT / COL_STR) before exec, so the storage paths never see COL_PARAM.
enum ColType {
    COL_INT = 0; COL_STR = 1; COL_BYTES = 2; COL_TEXT = 3; COL_PARAM = 4;
    COL_INT_SZ = 8; COL_STR_SZ = 256; COL_BYTES_SZ = 16;
}

# Blob page layout (4096 bytes; chained). Stores up to BY_DATA_MAX bytes;
# `BY_NEXT` points at the next blob page (0 = last). Chain is one-way.
# A row's BLOB field is 16 bytes: (first_page i64, length i64). length is
# the *total* payload in the chain — not per-page. A zero first_page means
# an empty blob (no pages allocated).
enum ByOff {
    BY_TYPE = 0;
    BY_LEN = 8;
    BY_NEXT = 16;
    BY_DATA = 24;
    BY_DATA_MAX = 4072;
}

# Row blob ref layout (16 bytes at a BLOB column's row offset).
enum BRefOff { BR_PAGE = 0; BR_LEN = 8; }

enum PatraErr {
    PATRA_OK = 0;
    PATRA_ERR_IO = 1;
    PATRA_ERR_MAGIC = 2;
    PATRA_ERR_FULL = 3;
    PATRA_ERR_EXISTS = 4;
    PATRA_ERR_NOTFOUND = 5;
    PATRA_ERR_SYNTAX = 6;
    PATRA_ERR_PAGE = 7;
    PATRA_ERR_ROWSZ = 8;
    PATRA_ERR_TYPE = 9;
    PATRA_ERR_COLCOUNT = 10;
    PATRA_ERR_PARAM = 11;
}

# Header layout (4096 bytes total — page 0)
#
# HDR_COMMITGEN (v1.12.0 P2) is a monotonic commit-generation counter living in
# the formerly-reserved 32..63 region (HDR_TBLCOUNT ends at 32, HDR_TBLDIR
# starts at 64). patra_hdr_init memsets the whole page to 0, so new AND old
# files read gen 0 — backward/forward compatible, NO format/version break
# (PATRA_VER stays 1; an old binary just ignores it). Every committed header
# write bumps it; a reader (on any handle or process) that finds the on-disk gen
# != its cached gen flushes the shared page cache (pcache.cyr). 8 of the 32
# reserved bytes are now used; HDR_DBID takes 40..47 (v1.13.8); 48..63 stay reserved.
enum HdrOff {
    HDR_MAGIC = 0;
    HDR_VER = 4;
    HDR_PGCOUNT = 8;
    HDR_FREEHEAD = 16;
    HDR_TBLCOUNT = 24;
    HDR_COMMITGEN = 32;
    # v1.13.8: random per-database identity, assigned on first open. Binds a
    # .wal to the database it protects — without it, wal_recover replayed an
    # orphaned WAL into whatever file later took that path. 0 = not yet
    # assigned (every file predating this, plus every freshly created one,
    # since patra_hdr_init zeroes the page). (audit 2026-08-18 S1-8)
    HDR_DBID = 40;
    HDR_TBLDIR = 64;
}

# Table directory entry (64 bytes each, max 63 entries)
enum TblOff {
    TBL_NAME = 0;
    TBL_NAME_MAX = 32;
    TBL_NCOLS = 32;
    TBL_ROOT = 40;
    TBL_NROWS = 48;
    TBL_SCHEMA = 56;
    TBL_ENTRY_SZ = 64;
}

# Schema page column layout (40 bytes per column)
enum SchOff {
    SCH_NCOLS = 0;
    SCH_START = 8;
    SCH_CNAME = 0;
    SCH_CNAME_MAX = 32;
    SCH_CTYPE = 32;
    SCH_ENTRY_SZ = 40;
}

# Data page layout
enum DPOff {
    DP_TYPE = 0;
    DP_NROWS = 8;
    DP_NEXT = 16;
    DP_DATA = 24;
}

# Free page layout
enum FPOff { FP_TYPE = 0; FP_NEXT = 8; }

# flock + fsync syscalls. The LOCK_* operations are universal; the syscall
# NUMBERS are per-target and come from the cyrius syscall peer where available.
#ifdef CYRIUS_TARGET_AGNOS
# agnos (1.46.x): flock is kernel #59 and lseek #58 — both supplied by the
# syscall peer (SYS_FLOCK / SYS_LSEEK), so they are NOT redefined here (a
# redefinition would shadow the peer). agnos has no per-fd fdatasync; map
# durability to whole-FS sync #12 (over-syncs but is correct).
enum Flock { LOCK_SH = 1; LOCK_EX = 2; LOCK_NB = 4; LOCK_UN = 8; }
enum Sync { SYS_FDATASYNC = 12; }
#endif
#ifndef CYRIUS_TARGET_AGNOS
# Linux/macos: SYS_FLOCK = 73 is supplied here for macos self-sufficiency (the
# macOS peer does not define it; both Linux peers do since cyrius 6.6.4, with the
# same value — a same-value redefinition is silent). The peer defines SYS_FDATASYNC
# (#75) on Linux, matched here for macos.
enum Flock { LOCK_SH = 1; LOCK_EX = 2; LOCK_NB = 4; LOCK_UN = 8; SYS_FLOCK = 73; }
enum Sync { SYS_FDATASYNC = 75; }
#endif

# ── Low-level operations ────────────────────

# Seek to byte offset in file
fn _pt_seek(fd, off): i64 {
    return syscall(SYS_LSEEK, fd, off, 0);
}

# Apply flock operation to fd
fn _pt_flock(fd, op): i64 {
    return syscall(SYS_FLOCK, fd, op);
}

# Acquire exclusive (write) lock
fn patra_lock_ex(fd): i64 { return _pt_flock(fd, LOCK_EX); }
# Acquire shared (read) lock
fn patra_lock_sh(fd): i64 { return _pt_flock(fd, LOCK_SH); }
# Release lock
fn patra_unlock(fd): i64 { return _pt_flock(fd, LOCK_UN); }

# ── Header management ────────────────────

# Initialize header buffer with magic and defaults
fn patra_hdr_init(buf): i64 {
    memset(buf, 0, PAGE_SIZE);
    store32(buf + HDR_MAGIC, PATRA_MAGIC);
    store32(buf + HDR_VER, PATRA_VER);
    store64(buf + HDR_PGCOUNT, 1);
}

# Read header page from file into buffer
fn patra_hdr_read(fd, buf): i64 {
    if (_pt_seek(fd, 0) < 0) { return PATRA_ERR_IO; }
    if (sys_read(fd, buf, PAGE_SIZE) != PAGE_SIZE) { return PATRA_ERR_IO; }
    return PATRA_OK;
}

# Write header page from buffer to file without fdatasync. Used by the
# group-commit path (1.8.0) — caller is responsible for syncing later.
# Write the header page without fdatasync (group-commit path).
fn patra_hdr_write_nosync(fd, buf): i64 {
    if (_pt_seek(fd, 0) < 0) { return PATRA_ERR_IO; }
    if (sys_write(fd, buf, PAGE_SIZE) != PAGE_SIZE) { return PATRA_ERR_IO; }
    return PATRA_OK;
}

# Write header page from buffer to file with fdatasync
fn patra_hdr_write(fd, buf): i64 {
    var r = patra_hdr_write_nosync(fd, buf);
    if (r != PATRA_OK) { return r; }
    syscall(SYS_FDATASYNC, fd);
    return PATRA_OK;
}

# Verify header magic + version + internal bounds. Audit 2026-04-21 §3.7
# rejects a malformed header that would let `tbl_find` walk past the 63-entry
# table directory or let `page_alloc` dereference a bogus free-list head.
# Verify header magic, version, and internal bounds.
fn patra_hdr_verify(buf): i64 {
    if (load32(buf + HDR_MAGIC) != PATRA_MAGIC) { return PATRA_ERR_MAGIC; }
    if (load32(buf + HDR_VER) != PATRA_VER) { return PATRA_ERR_MAGIC; }
    var pgc = load64(buf + HDR_PGCOUNT);
    if (pgc < 1) { return PATRA_ERR_PAGE; }
    var fh = load64(buf + HDR_FREEHEAD);
    if (fh != 0) {
        if (fh >= pgc) { return PATRA_ERR_PAGE; }
        if (fh < 1) { return PATRA_ERR_PAGE; }
    }
    var tc = load64(buf + HDR_TBLCOUNT);
    if (tc < 0) { return PATRA_ERR_PAGE; }
    if (tc > MAX_TABLES) { return PATRA_ERR_PAGE; }

    # 1.14.0: validate the table DIRECTORY, not just its count.
    #
    # Every consumer of these fields trusted them. TBL_NCOLS in particular is
    # read straight out of this page and used as a loop bound while indexing
    # SCH_ENTRY_SZ-sized entries into a 4 KB schema page — a crafted count of a
    # few thousand walks far past the buffer. TBL_ROOT / TBL_SCHEMA are used as
    # page numbers with no range check, so a crafted value reads an arbitrary
    # file offset into a page buffer, and TBL_NROWS sizes heap allocations.
    #
    # This runs on every patra_hdr_read, so it is the one place that sees the
    # directory before anything else does. At most MAX_TABLES (63) iterations
    # of four comparisons — unmeasurable next to the page read it follows.
    for (var ti = 0; ti < tc; ti = ti + 1) {
        var e = buf + HDR_TBLDIR + ti * TBL_ENTRY_SZ;
        var nc = load64(e + TBL_NCOLS);
        if (nc < 1) { return PATRA_ERR_PAGE; }
        if (nc > MAX_COLS) { return PATRA_ERR_PAGE; }
        var rt = load64(e + TBL_ROOT);
        if (rt < 1) { return PATRA_ERR_PAGE; }
        if (rt >= pgc) { return PATRA_ERR_PAGE; }
        var sc = load64(e + TBL_SCHEMA);
        if (sc < 1) { return PATRA_ERR_PAGE; }
        if (sc >= pgc) { return PATRA_ERR_PAGE; }
        if (load64(e + TBL_NROWS) < 0) { return PATRA_ERR_PAGE; }
    }
    return PATRA_OK;
}

# Log error message via sakshi
fn _pt_err(msg): i64 {
    sakshi_error(msg, strlen(msg));
}

# Column count off a schema page, clamped to what a schema page can hold.
#
# 1.14.0. SCH_NCOLS is read straight from disk and used as a loop bound while
# indexing SCH_ENTRY_SZ-sized entries into a 4 KB page and as an index into
# per-column type arrays; a crafted count walked far past both. The table
# directory's TBL_NCOLS is now validated in patra_hdr_verify, but SCH_NCOLS is a
# SECOND, independent on-disk copy read directly off the schema page, so it
# needs its own clamp — the two can disagree, and the query path historically
# sized from one and read with the other.
fn _sch_ncols_clamped(schema): i64 {
    var nc = load64(schema + SCH_NCOLS);
    if (nc < 0) { return 0; }
    if (nc > MAX_COLS) { return MAX_COLS; }
    return nc;
}

# ── File create / open ────────────────────

# O_NOFOLLOW prevents `open(2)` from following a symbolic link at the final path
# component. Audit 2026-04-21 §2.8: closes the TOCTOU/symlink plant described in
# CVE-2025-68146. ⚠ 1.14.3 (cyrius 6.6.4): the VALUES come from the stdlib peer now —
# `enum OpenFlag { O_NOFOLLOW = 131072; O_DIRECTORY = 65536; }` stood here with the
# x86_64 numbers, and on arm64 (whose fcntl.h overrides the generic set) those bits are
# O_LARGEFILE and O_DIRECT:
# the WAL open FOLLOWED a symlink and truncated its target, and _pt_sync_dir's
# directory open got EINVAL (cyrius issue 2026-09-12, traced on aarch64 at 6.6.3).
# On Darwin they are 0x100 / 0x100000. Never hardcode an O_* value.

# Create new .patra file (O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW,
# mode 0644 = 420). O_EXCL already refuses an existing target; O_NOFOLLOW
# additionally refuses a symlink pointed at the target path.
# Routed through file_open (io) not raw sys_open: agnos's sys_open is
# length-carrying (name, namelen, flags) and uses its own AO_* flag bits,
# so file_open bridges the ABI (Linux: verbatim passthrough). O_EXCL /
# O_NOFOLLOW hardening is preserved on Linux; on agnos those bits are
# dropped (create is already guarded by the prior open-fail path).
fn _pt_file_create(path): i64 {
    var fd = file_open(path, 194 + O_NOFOLLOW, 420);
    if (fd < 0) { return 0 - 1; }
    var buf = pg_alloc();
    patra_hdr_init(buf);
    _pt_seek(fd, 0);
    var r = sys_write(fd, buf, PAGE_SIZE);
    pg_free(buf);
    if (r != PAGE_SIZE) { sys_close(fd); return 0 - 1; }
    return fd;
}

# Open existing .patra file (O_RDWR | O_NOFOLLOW). Refuses symlinked targets
# on Linux. file_open bridges the agnos ABI (namelen + AO_* flags).
fn _pt_file_open(path): i64 {
    return file_open(path, 2 + O_NOFOLLOW, 0);
}

# fsync the DIRECTORY containing `path` (1.14.0).
#
# fsync on a file makes its CONTENTS durable; it says nothing about the
# directory entry that names it. The WAL is created and unlinked on the crash
# path, and neither was ever made durable, so after a power loss the filesystem
# could legitimately present either:
#
#   * a database whose pages were modified but whose .wal entry never landed —
#     the undo log is simply absent, and recovery has nothing to replay; or
#   * a .wal that still exists after the commit which unlinked it — replayed on
#     the next open, undoing committed work.
#
# Both are silent. Syncing the directory after the create and after each unlink
# orders those entries against the data the way the log's whole contract
# assumes.
#
# Best-effort by design: a platform where the directory cannot be opened for
# fsync (agnos today) is no worse off than before, so failure is not an error.
fn _pt_sync_dir(path): i64 {
    var n = strlen(path);
    var cut = 0 - 1;
    for (var i = 0; i < n; i = i + 1) {
        if (load8(path + i) == 47) { cut = i; }
    }
    var dir = 0;
    if (cut < 0) {
        dir = ".";
    } else {
        var dl = cut;
        if (dl == 0) { dl = 1; }
        var d = _pt_alloc(dl + 1);
        if (d == 0) { return 0; }
        memcpy(d, path, dl);
        store8(d + dl, 0);
        dir = d;
    }
    var dfd = file_open(dir, O_DIRECTORY, 0);
    if (dfd >= 0) {
        syscall(SYS_FDATASYNC, dfd);
        sys_close(dfd);
    }
    if (cut >= 0) { _pt_free(dir); }
    return 0;
}

# ── Allocator serialization (v1.12.0 P2) ───────────
#
# lib/freelist.cyr's fl_alloc/fl_free are NOT thread-safe — they mutate
# process-global free-list heads + the bump arena with plain load/store, no
# lock (unlike alloc.cyr's bump allocator, which has a CAS spinlock). Once
# concurrent readers run (the read lock drops in a later step) two reader
# threads can allocate at once (result sets, slab-overflow buffers) and corrupt
# the freelist. So EVERY patra-issued fl_alloc/fl_free goes through _pt_alloc /
# _pt_free, serialized by this process-global mutex. The critical section is
# just the freelist splice (tiny), so contention is far below the old
# whole-statement mutex. _pt_alloc_mtx is created in patra_init; 0 before then
# means single-threaded (no lock) — the same no-op contract as _patra_mtx.
# LOCK-ORDER INVARIANT: the page cache (pcache.cyr, added later) must NEVER hold
# its _pc_mtx across an _pt_alloc / _pt_free call — allocation is always done
# outside the cache lock, so the two mutexes never nest.
var _pt_alloc_mtx = 0;

fn _pt_alloc(n): i64 {
    if (_pt_alloc_mtx == 0) { return fl_alloc(n); }
    mutex_lock(_pt_alloc_mtx);
    var p = fl_alloc(n);
    mutex_unlock(_pt_alloc_mtx);
    return p;
}

fn _pt_free(p): i64 {
    if (_pt_alloc_mtx == 0) { return fl_free(p); }
    mutex_lock(_pt_alloc_mtx);
    fl_free(p);
    mutex_unlock(_pt_alloc_mtx);
    return 0;
}

# ── Page slab (4KB buffer pool) ───────────
#
# Hot paths (page_read/_write callers, btree node walks, schema reads,
# bytes-chain walks) allocate and free PAGE_SIZE-sized scratch buffers
# tens of times per `patra_exec`. fl_alloc/fl_free goes through size-class
# lookup + freelist bookkeeping; a small LIFO stack of pre-allocated
# 4KB buffers skips both. Cap at PG_SLAB_MAX so a long-running consumer
# can't accumulate unbounded retained memory; overflows fall back to
# freelist transparently. Callers must pair pg_alloc / pg_free — slab
# correctness depends on every pushed buffer being PAGE_SIZE.
#
# PER-THREAD (v1.12.0 P2): the slab is a non-atomic LIFO, so two concurrent
# reader threads sharing one would lose updates (hand out the same buffer or
# leak one). Each thread keeps its OWN slab in TLS (lib/thread_local.cyr) —
# slot 3 = stack array ptr, slot 4 = top index (slots 0-2 are the SQL parse
# scratch, sql.cyr). The backing array is alloc()'d (thread-safe bump) lazily
# per thread; the buffers it caches come from fl_alloc on overflow, still
# serialized by _patra_lock until the read lock is dropped (S5) behind the
# allocator mutex (S3). Note: each worker thread retains up to PG_SLAB_MAX
# 4KB buffers, so a large reader pool multiplies retained slab memory.
enum SlabConst { PG_SLAB_MAX = 32; }

# v6.4.65: patra's five thread-local slots are now claimed from cyrius's slot
# allocator (thread_local_alloc, cyrius >= 6.4.65) instead of the hardcoded 0-4
# literals, closing the shared-namespace collision class — a server linking patra
# + sigil could otherwise clobber each other's per-thread state (cyrius issue
# 2026-07-01-thread-local-slot-namespace). The three SQL-parse slots are defined
# in src/sql.cyr; the two page-slab slots here. All five are allocated together,
# exactly once, by _patra_tls_ensure(). -1 = not yet allocated.  #skip-lint
var TLS_SLAB_STACK = 0 - 1;
var TLS_SLAB_TOP = 0 - 1;
var _patra_tls_gate = 0;     # CAS gate: one thread allocates the five slots
var _patra_tls_ready = 0;    # published once all five slot indices are assigned

# Claim patra's five thread-local slot indices from the cyrius allocator, once,
# at runtime (so thread_local's base counter is initialized regardless of include
# order). A CAS gate elects one allocator; a concurrent caller spins the few
# nanoseconds until it publishes. Called at the head of both TLS entry points
# (_sql_ensure, _pg_slab_init) so the indices exist before any get/set; the fast
# path (already ready) is a single compare.
# v1.13.6: per-thread lexer/parser error flag. Must be per-thread, not global —
# readers parse concurrently (v1.12.0 dropped the statement mutex on the read
# path), so a shared flag would cross-contaminate parses.
var TLS_LEXERR = 0 - 1;

fn _patra_tls_ensure(): i64 {
    if (_patra_tls_ready == 1) { return 0; }
    if (atomic_cas(&_patra_tls_gate, 0, 1) != 0) {
        TLS_TOKS = thread_local_alloc();
        TLS_PR = thread_local_alloc();
        TLS_NTOKS = thread_local_alloc();
        TLS_LEXERR = thread_local_alloc();
        TLS_SLAB_STACK = thread_local_alloc();
        TLS_SLAB_TOP = thread_local_alloc();
        _patra_tls_ready = 1;
    }
    while (_patra_tls_ready == 0) { }   # loser waits for the winner to publish
    return 0;
}

fn _pg_slab_init(): i64 {
    _patra_tls_ensure();
    if (thread_local_get(TLS_SLAB_STACK) == 0) {
        thread_local_set(TLS_SLAB_STACK, alloc(PG_SLAB_MAX * 8));
    }
    return 0;
}

# Allocate a 4KB buffer from this thread's page slab, falling back to fl_alloc.
fn pg_alloc(): i64 {
    _pg_slab_init();
    var top = thread_local_get(TLS_SLAB_TOP);
    if (top > 0) {
        top = top - 1;
        thread_local_set(TLS_SLAB_TOP, top);
        return load64(thread_local_get(TLS_SLAB_STACK) + top * 8);
    }
    return _pt_alloc(PAGE_SIZE);
}

# Return a 4KB buffer to this thread's page slab, or to fl_free if it's full.
fn pg_free(buf): i64 {
    if (buf == 0) { return 0; }
    _pg_slab_init();
    var top = thread_local_get(TLS_SLAB_TOP);
    if (top < PG_SLAB_MAX) {
        store64(thread_local_get(TLS_SLAB_STACK) + top * 8, buf);
        thread_local_set(TLS_SLAB_TOP, top + 1);
        return 0;
    }
    _pt_free(buf);
    return 0;
}
