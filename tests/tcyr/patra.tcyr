    patra_exec(db, "CREATE TABLE refs (id INT, name STR)");
    patra_exec(db, "CREATE INDEX ON refs (id)");
    patra_exec(db, "INSERT INTO refs VALUES (10, 'first')");
    patra_close(db);

    var db2 = patra_open(_tpath);
    # Index survives reopen; conflict probe still fires.
    assert_eq(patra_exec(db2, "INSERT OR IGNORE INTO refs VALUES (10, 'second')"), PATRA_OK, "ignored across reopen");
    var rs = patra_query(db2, "SELECT * FROM refs");
    assert_eq(patra_result_count(rs), 1, "still 1 row");
    assert_streq(patra_result_get_str(rs, 0, 1), "first", "original preserved");
