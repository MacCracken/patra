fn test_text_delete_frees() {
    test_group("text delete frees chain");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE bigt (id INT AUTOINCREMENT, body TEXT)");
    _text_big_insert(db, 65, 9000);
    _text_big_insert(db, 66, 9000);
    var hdr = _db_hdr(db);
    var pg_before = load64(hdr + HDR_PGCOUNT);
    assert_eq(patra_exec(db, "DELETE FROM bigt WHERE id = 1"), PATRA_OK, "delete");
    assert_eq(load64(hdr + HDR_PGCOUNT), pg_before, "pgcount unchanged");
    assert_eq(load64(hdr + HDR_FREEHEAD) != 0, 1, "freehead set (chain freed)");
    var rs = patra_query(db, "SELECT * FROM bigt");
    assert_eq(patra_result_count(rs), 1, "1 row left");
    patra_result_free(rs);
    patra_close(db);
}

# Regression for the v1.12.8 flock-window fix: a result set's TEXT/BLOB payload
# must be a SNAPSHOT taken under the query's shared flock, not a lazy on-disk read
# after the flock was dropped. Deterministically reproduces the readback race in a
# single thread: query, then free + reuse the row's payload pages, then read the
# still-open result. Pre-fix the read returned the reused-page bytes; post-fix it
# returns the original snapshot.
fn test_text_readback_snapshot() {
    test_group("text readback snapshot (flock-window fix)");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE bigt (id INT AUTOINCREMENT, body TEXT)");
    # Row 1: 9000 bytes of 'A' -> a multi-page chain.
    _text_big_insert(db, 65, 9000);
    # Capture the result set. Pre-fix this held only an on-disk byte-ref; post-fix
    # _rs_materialize snapshots the payload into an owned buffer under the flock.
    var rs = patra_query(db, "SELECT * FROM bigt WHERE id = 1");
    assert_eq(patra_result_count(rs), 1, "1 row captured");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 9000, "snapshot len 9000");
    # Churn the pages the row occupied: DELETE frees the 'A' chain to the freelist,
    # then reinserting the same size REUSES those exact pages, overwriting them
    # with 'B'. Pre-fix, the still-open rs reads these reused pages and returns 'B'
    # (or PATRA_ERR_PAGE); post-fix it returns the original 'A' snapshot.
    assert_eq(patra_exec(db, "DELETE FROM bigt WHERE id = 1"), PATRA_OK, "delete row 1");
    assert_eq(load64(_db_hdr(db) + HDR_FREEHEAD) != 0, 1, "chain freed to freelist");
    _text_big_insert(db, 66, 9000);   # 'B' — reuses the just-freed pages
    _text_big_insert(db, 66, 9000);   # a second, to consume the freelist head
    # Read the OLD result set: must be the original 'A' snapshot, never reused 'B'.
    var out = fl_alloc(9000);
    memset(out, 0, 9000);
    assert_eq(patra_result_read_text(db, rs, 0, 1, out), PATRA_OK, "read snapshot ok");
    assert_eq(_all_byte(out, 65, 9000), 1, "snapshot is original 'A', not reused-page 'B'");
    fl_free(out);
    patra_result_free(rs);
    patra_close(db);
}

fn test_text_where_and_index_rejected() {
    test_group("text where + index rejected");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, body TEXT)");
    patra_exec(db, "INSERT INTO t (id, body) VALUES (1, 'abc')");
    # WHERE on TEXT never matches (variable-length isn't comparable).
    var rs = patra_query(db, "SELECT * FROM t WHERE body = 'abc'");
    assert_eq(patra_result_count(rs), 0, "where on text: no match");
    patra_result_free(rs);
    # CREATE INDEX on TEXT is rejected.
    assert_eq(patra_exec(db, "CREATE INDEX ON t (body)"), PATRA_ERR_TYPE, "no index on text");
    patra_close(db);
}

fn test_text_alter_add() {
    test_group("text alter add");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    patra_exec(db, "INSERT INTO t VALUES (1, 'alice')");
    assert_eq(patra_exec(db, "ALTER TABLE t ADD COLUMN bio TEXT"), PATRA_OK, "add text col");
    # Existing row's new TEXT cell defaults to empty.
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_get_text_len(rs, 0, 2), 0, "existing row empty text");
    patra_result_free(rs);
    # New inserts can populate it.
    assert_eq(patra_exec(db, "INSERT INTO t (id, name, bio) VALUES (2, 'bob', 'a bio')"), PATRA_OK, "insert with text");
    var rs2 = patra_query(db, "SELECT * FROM t WHERE id = 2");
    assert_eq(patra_result_get_text_len(rs2, 0, 2), 5, "bio len 5");
    patra_result_free(rs2);
    patra_close(db);
}

# -- v1.10.3: bind parameters --------------------------------

fn test_parse_bind() {
    test_group("parse bind params");
    sql_tokenize("INSERT INTO t VALUES (?, ?)");
    assert_eq(sql_parse(), PATRA_OK, "insert ? parses");
    assert_eq(load64(_spr() + PR_NPARAMS), 2, "2 params");
    sql_tokenize("SELECT * FROM t WHERE id = ?");
    assert_eq(sql_parse(), PATRA_OK, "select ? parses");
    assert_eq(load64(_spr() + PR_NPARAMS), 1, "1 param");
    sql_tokenize("UPDATE t SET name = ? WHERE id = ?");
    assert_eq(sql_parse(), PATRA_OK, "update ? parses");
    assert_eq(load64(_spr() + PR_NPARAMS), 2, "2 params (set+where)");
    sql_tokenize("INSERT INTO t VALUES (1, 'x')");
    assert_eq(sql_parse(), PATRA_OK, "no-param parses");
    assert_eq(load64(_spr() + PR_NPARAMS), 0, "0 params");
}

fn test_bind_insert() {
    test_group("bind insert");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    var ins = patra_prepare(db, "INSERT INTO t VALUES (?, ?)");
    assert(ins != 0, "prepare");
    assert_eq(patra_bind_int(ins, 0, 42), PATRA_OK, "bind id");
    assert_eq(patra_bind_text(ins, 1, "alice", 5), PATRA_OK, "bind name");
    assert_eq(patra_exec_prepared(db, ins), PATRA_OK, "exec");
    patra_finalize(ins);
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "1 row");
    assert_eq(patra_result_get_int(rs, 0, 0), 42, "id 42");
    assert_streq(patra_result_get_str(rs, 0, 1), "alice", "name alice");
    patra_result_free(rs);
    patra_close(db);
}

fn test_bind_text_quotes() {
    test_group("bind text quotes (injection regression)");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    var ins = patra_prepare(db, "INSERT INTO t VALUES (?, ?)");
    patra_bind_int(ins, 0, 1);
    # A value with a quote + SQL would truncate/inject as a literal; bound, it
    # stores verbatim and the table is untouched.
    var evil = "O'Brien'; DROP TABLE t--";
    patra_bind_text(ins, 1, evil, strlen(evil));
    assert_eq(patra_exec_prepared(db, ins), PATRA_OK, "exec with quote");
    patra_finalize(ins);
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "table intact, 1 row");
    assert_streq(patra_result_get_str(rs, 0, 1), evil, "stored verbatim");
    patra_result_free(rs);
    patra_close(db);
}

# A value containing a single quote, written through a consumer-built SQL string
# (patra_exec / patra_query), no longer drops the record: a doubled '' is standard
# SQL for one literal quote and the tokenizer now unescapes it in place. Before
# this fix, INSERT ... VALUES ('it''s') returned PATRA_ERR_SYNTAX and the row was
# silently lost (the P1 corruption libro's audit chain hit). Binds are unaffected
# (they never pass through the SQL string) — covered by test_bind_text_quotes.
fn test_exec_quote_escaping() {
    test_group("exec '' escaping (quote-in-value INSERT via patra_exec)");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR, body TEXT)");

    # One-shot patra_exec with escaped '' — previously PATRA_ERR_SYNTAX + dropped.
    assert_eq(patra_exec(db, "INSERT INTO t VALUES (1, 'it''s', 'a ''b'' c')"),
              PATRA_OK, "insert with '' ok");

    var rs = patra_query(db, "SELECT id, name, body FROM t WHERE id = 1");
    assert_eq(patra_result_count(rs), 1, "row landed");
    assert_streq(patra_result_get_str(rs, 0, 1), "it's", "STR '' unescaped");
    # TEXT column read by length: a 'b' c  (7 bytes)
    var blen = patra_result_get_text_len(rs, 0, 2);
    assert_eq(blen, 7, "TEXT '' unescaped len");
    var tb = fl_alloc(blen + 1);
    patra_result_read_text(db, rs, 0, 2, tb);
    store8(tb + blen, 0);
    assert_streq(tb, "a 'b' c", "TEXT '' unescaped bytes");
    fl_free(tb);
    patra_result_free(rs);

    # A '' literal in a WHERE clause unescapes and matches the stored STR value.
    var rs2 = patra_query(db, "SELECT id FROM t WHERE name = 'it''s'");
    assert_eq(patra_result_count(rs2), 1, "WHERE '' matches STR");
    patra_result_free(rs2);

    # patra_quote_str doubles single-quotes: O'Brien (7) -> O''Brien (8).
    var q = fl_alloc(64);
    assert_eq(patra_quote_str(q, "O'Brien", 7), 8, "quote_str len");
    store8(q + 8, 0);
    assert_streq(q, "O''Brien", "quote_str doubles quote");
    fl_free(q);

    patra_close(db);
}

fn test_bind_where() {
    test_group("bind where");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    patra_exec(db, "INSERT INTO t VALUES (1, 'alice')");
    patra_exec(db, "INSERT INTO t VALUES (2, 'bob')");
    var sel = patra_prepare(db, "SELECT * FROM t WHERE id = ?");
    patra_bind_int(sel, 0, 2);
    var rs = patra_query_prepared(db, sel);
    assert_eq(patra_result_count(rs), 1, "1 match (indexed)");
    assert_streq(patra_result_get_str(rs, 0, 1), "bob", "bob");
    patra_result_free(rs);
    patra_finalize(sel);
    var sel2 = patra_prepare(db, "SELECT * FROM t WHERE name = ?");
    patra_bind_text(sel2, 0, "alice", 5);
    var rs2 = patra_query_prepared(db, sel2);
    assert_eq(patra_result_count(rs2), 1, "name match (scan)");
    assert_eq(patra_result_get_int(rs2, 0, 0), 1, "id 1");
    patra_result_free(rs2);
    patra_finalize(sel2);
    patra_close(db);
}

fn test_bind_update() {
    test_group("bind update");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    patra_exec(db, "INSERT INTO t VALUES (1, 'alice')");
    var up = patra_prepare(db, "UPDATE t SET name = ? WHERE id = ?");
