    patra_close(db2);
}

fn test_result_str_len() {
    test_group("result str_len");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    patra_exec(db, "INSERT INTO t VALUES (1, '')");
    patra_exec(db, "INSERT INTO t VALUES (2, 'alice')");

    # 255 'a' bytes -- the COL_STR_SZ-1 ceiling row_write_str clamps to.
    var max = fl_alloc(256);
    memset(max, 0, 256);
    for (var i = 0; i < 255; i = i + 1) { store8(max + i, 97); }
    var types = fl_alloc(16);
    var ivals = fl_alloc(16);
    var sptrs = fl_alloc(16);
    var slens = fl_alloc(16);
    memset(types, 0, 16); memset(ivals, 0, 16);
    memset(sptrs, 0, 16); memset(slens, 0, 16);
    store64(types + 0, COL_INT);
    store64(ivals + 0, 3);
    store64(types + 8, COL_STR);
    store64(sptrs + 8, max);
    store64(slens + 8, 255);
    assert_eq(patra_insert_row(db, "t", 1, 2, types, ivals, sptrs, slens, 0, 0), PATRA_OK, "insert max");
    fl_free(slens); fl_free(sptrs); fl_free(ivals); fl_free(types); fl_free(max);

    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 3, "3 rows");
    assert_eq(patra_result_get_str_len(rs, 0, 1), 0, "empty");
    assert_eq(patra_result_get_str_len(rs, 1, 1), 5, "alice");
    assert_eq(patra_result_get_str_len(rs, 2, 1), 255, "max 255");
    assert_eq(patra_result_get_str_len(rs, 0, 0), 0 - 1, "non-STR returns -1");
    patra_result_free(rs);
    patra_close(db);
}

# -- Runner --------------------------------------------------

# -- v1.10.0: INSERT column list ------------------------------

fn test_parse_insert_collist() {
    test_group("parse insert collist");
    sql_tokenize("INSERT INTO t (id, name) VALUES (1, 'alice')");
    assert_eq(sql_parse(), PATRA_OK, "named list parses");
    assert_eq(load64(_spr() + PR_INS_NCOLS), 2, "2 named cols");
    assert_eq(load64(_spr() + PR_COUNT), 2, "2 values");

    sql_tokenize("INSERT INTO t VALUES (1, 'alice')");
    assert_eq(sql_parse(), PATRA_OK, "positional parses");
    assert_eq(load64(_spr() + PR_INS_NCOLS), 0, "positional => 0 named");

    sql_tokenize("INSERT INTO t () VALUES (1)");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "empty list rejected");

    sql_tokenize("INSERT INTO t (id name) VALUES (1, 2)");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "missing comma rejected");

    sql_tokenize("INSERT INTO t (id, id) VALUES (1, 2)");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "duplicate column rejected");
}

fn test_insert_collist_reorder() {
    test_group("insert collist reorder");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_exec(db, "CREATE TABLE t (id INT, name STR, age INT)"), PATRA_OK, "create");
    # Columns named out of declaration order -- values bind by name.
    assert_eq(patra_exec(db, "INSERT INTO t (name, age, id) VALUES ('alice', 30, 1)"), PATRA_OK, "reordered insert");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "1 row");
    assert_eq(patra_result_get_int(rs, 0, 0), 1, "id bound");
    assert_streq(patra_result_get_str(rs, 0, 1), "alice", "name bound");
    assert_eq(patra_result_get_int(rs, 0, 2), 30, "age bound");
    patra_result_free(rs);
    patra_close(db);
}

fn test_insert_collist_partial() {
    test_group("insert collist partial");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_exec(db, "CREATE TABLE t (id INT, name STR, age INT)"), PATRA_OK, "create");
    # age omitted -- defaults to 0; name omitted -- defaults to empty string.
    assert_eq(patra_exec(db, "INSERT INTO t (id, name) VALUES (7, 'bob')"), PATRA_OK, "partial insert");
    assert_eq(patra_exec(db, "INSERT INTO t (id) VALUES (8)"), PATRA_OK, "id-only insert");
    var rs = patra_query(db, "SELECT * FROM t WHERE id = 7");
    assert_eq(patra_result_get_int(rs, 0, 2), 0, "omitted INT => 0");
    patra_result_free(rs);
    var rs2 = patra_query(db, "SELECT * FROM t WHERE id = 8");
    assert_streq(patra_result_get_str(rs2, 0, 1), "", "omitted STR => empty");
    assert_eq(patra_result_get_int(rs2, 0, 2), 0, "omitted INT => 0");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_insert_collist_errors() {
    test_group("insert collist errors");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    assert_eq(patra_exec(db, "INSERT INTO t (ghost) VALUES (1)"), PATRA_ERR_NOTFOUND, "unknown col");
    assert_eq(patra_exec(db, "INSERT INTO t (id, name) VALUES (1)"), PATRA_ERR_COLCOUNT, "value count < cols");
    assert_eq(patra_exec(db, "INSERT INTO t (id) VALUES (1, 2)"), PATRA_ERR_COLCOUNT, "value count > cols");
    assert_eq(patra_exec(db, "INSERT INTO t (id) VALUES ('str')"), PATRA_ERR_TYPE, "type mismatch");
    patra_close(db);
}

fn test_insert_collist_or_ignore() {
    test_group("insert collist or ignore");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    patra_exec(db, "CREATE INDEX ON t (id)");
    assert_eq(patra_exec(db, "INSERT INTO t (id, name) VALUES (1, 'a')"), PATRA_OK, "seed row");
    # OR IGNORE composes with the column list -- the dedup probe reads the
    # bound id from the built row regardless of value order.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO t (name, id) VALUES ('b', 1)"), PATRA_OK, "ignored dup");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "still 1 row");
    assert_streq(patra_result_get_str(rs, 0, 1), "a", "original kept");
    patra_result_free(rs);
    patra_close(db);
}

fn test_insert_collist_prepared() {
    test_group("insert collist prepared");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");
    var ins = patra_prepare(db, "INSERT INTO t (name, id) VALUES ('zed', 9)");
    assert(ins != 0, "prepare collist insert");
    assert_eq(patra_exec_prepared(db, ins), PATRA_OK, "run prepared collist");
    patra_finalize(ins);
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_get_int(rs, 0, 0), 9, "id bound via prepared");
    assert_streq(patra_result_get_str(rs, 0, 1), "zed", "name bound via prepared");
    patra_result_free(rs);
    patra_close(db);
}

# -- v1.10.1: AUTOINCREMENT / rowid ---------------------------

fn test_parse_autoinc() {
    test_group("parse autoinc");
    sql_tokenize("CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    assert_eq(sql_parse(), PATRA_OK, "autoinc on int parses");
    assert_eq(load64(_spr() + PR_AUTOINC), 1, "auto col 0 => 1");

    sql_tokenize("CREATE TABLE t (id INT, seq INT AUTOINCREMENT)");
    assert_eq(sql_parse(), PATRA_OK, "autoinc on 2nd int");
    assert_eq(load64(_spr() + PR_AUTOINC), 2, "auto col 1 => 2");

    sql_tokenize("CREATE TABLE t (id INT, name STR)");
    assert_eq(sql_parse(), PATRA_OK, "no autoinc");
    assert_eq(load64(_spr() + PR_AUTOINC), 0, "no autoinc => 0");

    sql_tokenize("CREATE TABLE t (name STR AUTOINCREMENT)");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "autoinc on str rejected");

    sql_tokenize("CREATE TABLE t (a INT AUTOINCREMENT, b INT AUTOINCREMENT)");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "two autoinc rejected");
}

fn test_autoinc_basic() {
    test_group("autoinc basic");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)"), PATRA_OK, "create");
    # Column-list omitting the auto id => sequential 1, 2, 3.
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('alice')"), PATRA_OK, "ins1");
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('bob')"), PATRA_OK, "ins2");
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('carol')"), PATRA_OK, "ins3");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 3, "3 rows");
    assert_eq(patra_result_get_int(rs, 0, 0), 1, "id 1");
    assert_eq(patra_result_get_int(rs, 1, 0), 2, "id 2");
    assert_eq(patra_result_get_int(rs, 2, 0), 3, "id 3");
    patra_result_free(rs);
    patra_close(db);
}

fn test_autoinc_explicit_and_zero() {
    test_group("autoinc explicit + zero");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    # Positional 0 auto-assigns; explicit non-zero is honored; next auto = max+1.
    assert_eq(patra_exec(db, "INSERT INTO t VALUES (0, 'a')"), PATRA_OK, "zero => auto");
    assert_eq(patra_exec(db, "INSERT INTO t VALUES (100, 'b')"), PATRA_OK, "explicit honored");
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('c')"), PATRA_OK, "auto after explicit");
    var rs = patra_query(db, "SELECT * FROM t WHERE id = 1");
    assert_eq(patra_result_count(rs), 1, "zero became 1");
    patra_result_free(rs);
    var rs2 = patra_query(db, "SELECT * FROM t WHERE id = 101");
    assert_eq(patra_result_count(rs2), 1, "auto continues from max(100)+1");
    assert_streq(patra_result_get_str(rs2, 0, 1), "c", "row c at 101");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_autoinc_reseed_after_delete() {
    test_group("autoinc reseed after delete");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    patra_exec(db, "INSERT INTO t (name) VALUES ('a')");
    patra_exec(db, "INSERT INTO t (name) VALUES ('b')");
    patra_exec(db, "INSERT INTO t (name) VALUES ('c')");
    # Deleting the highest id lets it be reused (derive-from-MAX semantics,
    # matching the consumer's prior SELECT MAX(id) seeding).
    patra_exec(db, "DELETE FROM t WHERE id = 3");
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('d')"), PATRA_OK, "reinsert");
    var rs = patra_query(db, "SELECT * FROM t WHERE id = 3");
    assert_eq(patra_result_count(rs), 1, "id 3 reused");
    assert_streq(patra_result_get_str(rs, 0, 1), "d", "now holds d");
    patra_result_free(rs);
    patra_close(db);
}

fn test_autoinc_persistence() {
    test_group("autoinc persistence");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    patra_exec(db, "INSERT INTO t (name) VALUES ('a')");
    patra_exec(db, "INSERT INTO t (name) VALUES ('b')");
    patra_close(db);
    # Reopen: the auto-id marker persists in the schema page; next id = max+1.
    db = patra_open(_tpath);
    assert_eq(patra_exec(db, "INSERT INTO t (name) VALUES ('c')"), PATRA_OK, "ins after reopen");
    var rs = patra_query(db, "SELECT * FROM t WHERE id = 3");
    assert_eq(patra_result_count(rs), 1, "continues from persisted max");
    assert_streq(patra_result_get_str(rs, 0, 1), "c", "row c at 3");
    patra_result_free(rs);
    patra_close(db);
}

# -- v1.11.3: last_insert_id / rows_affected (yeo-cy-test) ----

fn test_last_insert_id() {
    test_group("last_insert_id");
    cleanup();
    var db = patra_open(_tpath);
    # Fresh handle: nothing inserted yet.
    assert_eq(patra_last_insert_id(db), 0, "fresh handle => 0");
    # Null handle is tolerated.
    assert_eq(patra_last_insert_id(0), 0, "null db => 0");

    patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    patra_exec(db, "INSERT INTO t (name) VALUES ('a')");
    assert_eq(patra_last_insert_id(db), 1, "first auto id = 1");
    patra_exec(db, "INSERT INTO t (name) VALUES ('b')");
    assert_eq(patra_last_insert_id(db), 2, "second auto id = 2");

    # Explicit id is reflected too (sqlite3_last_insert_rowid parity).
    patra_exec(db, "INSERT INTO t VALUES (100, 'c')");
    assert_eq(patra_last_insert_id(db), 100, "explicit id reflected");
    # Auto continues from max+1 = 101.
    patra_exec(db, "INSERT INTO t (name) VALUES ('d')");
    assert_eq(patra_last_insert_id(db), 101, "auto continues 101");

    # UPDATE / DELETE must not touch last_insert_id.
    patra_exec(db, "UPDATE t SET name = 'A' WHERE id = 1");
    assert_eq(patra_last_insert_id(db), 101, "update leaves last id");
    patra_exec(db, "DELETE FROM t WHERE id = 1");
    assert_eq(patra_last_insert_id(db), 101, "delete leaves last id");

    # A table without an AUTOINCREMENT column leaves last id unchanged.
    patra_exec(db, "CREATE TABLE p (x INT, y INT)");
    patra_exec(db, "INSERT INTO p VALUES (5, 6)");
    assert_eq(patra_last_insert_id(db), 101, "non-autoinc insert leaves last id");
    patra_close(db);
}

fn test_last_insert_id_or_ignore() {
    test_group("last_insert_id OR IGNORE");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, id INT AUTOINCREMENT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs (hash) VALUES ('x')");
    assert_eq(patra_last_insert_id(db), 1, "first id = 1");
    # A conflicting OR IGNORE is a no-op: last_insert_id must not advance.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO objs (hash) VALUES ('x')"), PATRA_OK, "ignored ok");
    assert_eq(patra_last_insert_id(db), 1, "ignore leaves last id");
    # A non-conflicting OR IGNORE does insert and advances it.
    patra_exec(db, "INSERT OR IGNORE INTO objs (hash) VALUES ('y')");
    assert_eq(patra_last_insert_id(db), 2, "fresh insert advances to 2");
    patra_close(db);
}

fn test_rows_affected() {
    test_group("rows_affected");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_rows_affected(db), 0, "fresh handle => 0");
    assert_eq(patra_rows_affected(0), 0, "null db => 0");

    patra_exec(db, "CREATE TABLE people (id INT, name STR, age INT)");
    assert_eq(patra_exec(db, "INSERT INTO people VALUES (1, 'alice', 25)"), PATRA_OK, "ins1");
    assert_eq(patra_rows_affected(db), 1, "insert => 1");
    patra_exec(db, "INSERT INTO people VALUES (2, 'bob', 25)");
    patra_exec(db, "INSERT INTO people VALUES (3, 'carol', 40)");

    # Multi-row UPDATE reports the matched count.
    patra_exec(db, "UPDATE people SET age = 99 WHERE age = 25");
    assert_eq(patra_rows_affected(db), 2, "update matched 2");
    # No-match UPDATE reports 0 (the "nothing there" signal the consumer wants).
    patra_exec(db, "UPDATE people SET age = 0 WHERE id = 999");
    assert_eq(patra_rows_affected(db), 0, "update matched 0");

    # DELETE reports the deleted count; no-match is 0.
    patra_exec(db, "DELETE FROM people WHERE age = 99");
    assert_eq(patra_rows_affected(db), 2, "delete removed 2");
    patra_exec(db, "DELETE FROM people WHERE id = 999");
    assert_eq(patra_rows_affected(db), 0, "delete removed 0");
    patra_close(db);
}

fn test_rows_affected_or_ignore() {
    test_group("rows_affected OR IGNORE");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('a', 1)");
    assert_eq(patra_rows_affected(db), 1, "first insert => 1");
    # Conflicting OR IGNORE inserts nothing.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO objs VALUES ('a', 2)"), PATRA_OK, "ignored ok");
    assert_eq(patra_rows_affected(db), 0, "ignored insert => 0");
    # Non-conflicting OR IGNORE inserts.
    patra_exec(db, "INSERT OR IGNORE INTO objs VALUES ('b', 3)");
    assert_eq(patra_rows_affected(db), 1, "fresh insert => 1");
    patra_close(db);
}

# -- v1.11.5: atomic insert/exec returning (yeo-cy-test) -----

fn test_insert_returning() {
    test_group("insert_returning");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT AUTOINCREMENT, name STR)");
    var id = fl_alloc(8);

    var ins = patra_prepare(db, "INSERT INTO t (name) VALUES ('a')");
    assert_eq(patra_insert_returning(db, ins, id), PATRA_OK, "ins ok");
    assert_eq(load64(id), 1, "returns assigned id 1");
    # Same value as the separate readback, and atomic with the write.
    assert_eq(patra_last_insert_id(db), 1, "last_insert_id agrees");
    assert_eq(patra_insert_returning(db, ins, id), PATRA_OK, "ins ok 2");
    assert_eq(load64(id), 2, "returns assigned id 2");
    patra_finalize(ins);

    # out_id = 0 is tolerated (caller only wants the status).
    var ins3 = patra_prepare(db, "INSERT INTO t (name) VALUES ('c')");
    assert_eq(patra_insert_returning(db, ins3, 0), PATRA_OK, "null out_id ok");
    assert_eq(patra_last_insert_id(db), 3, "id advanced to 3");
    patra_finalize(ins3);

    # Non-AUTOINCREMENT table: like patra_last_insert_id, the field is left at
    # the prior INSERT's id (3) — patra_insert_returning is only meaningful on
    # an AUTOINCREMENT target.
    patra_exec(db, "CREATE TABLE p (x INT, y INT)");
    var insp = patra_prepare(db, "INSERT INTO p VALUES (5, 6)");
    store64(id, 99);
    assert_eq(patra_insert_returning(db, insp, id), PATRA_OK, "ins p ok");
    assert_eq(load64(id), 3, "non-autoinc leaves prior id (mirrors last_insert_id)");
    patra_finalize(insp);

    # Null handle: status error, out_id zeroed (no stale value leaks).
    store64(id, 77);
    assert_eq(patra_insert_returning(0, ins, id), PATRA_ERR_IO, "null db => IO err");
    assert_eq(load64(id), 0, "out_id zeroed on error");
    fl_free(id);
    patra_close(db);
}

fn test_insert_returning_or_ignore() {
    test_group("insert_returning OR IGNORE");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, id INT AUTOINCREMENT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    var id = fl_alloc(8);

    var ins = patra_prepare(db, "INSERT OR IGNORE INTO objs (hash) VALUES ('x')");
    assert_eq(patra_insert_returning(db, ins, id), PATRA_OK, "first ok");
    assert_eq(load64(id), 1, "first id = 1");
    # Conflicting OR IGNORE: no row stored, id must not advance.
    assert_eq(patra_insert_returning(db, ins, id), PATRA_OK, "ignored ok");
    assert_eq(load64(id), 1, "ignored leaves id at 1");
    patra_finalize(ins);
    fl_free(id);
    patra_close(db);
}

fn test_exec_returning() {
    test_group("exec_returning");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE people (id INT, name STR, age INT)");
    patra_exec(db, "INSERT INTO people VALUES (1, 'a', 25)");
    patra_exec(db, "INSERT INTO people VALUES (2, 'b', 25)");
    patra_exec(db, "INSERT INTO people VALUES (3, 'c', 40)");
    var n = fl_alloc(8);

    var upd = patra_prepare(db, "UPDATE people SET age = 99 WHERE age = 25");
    assert_eq(patra_exec_returning(db, upd, n), PATRA_OK, "update ok");
    assert_eq(load64(n), 2, "update matched 2");
    patra_finalize(upd);

    var del = patra_prepare(db, "DELETE FROM people WHERE id = 999");
    assert_eq(patra_exec_returning(db, del, n), PATRA_OK, "delete ok");
    assert_eq(load64(n), 0, "delete matched 0");
    patra_finalize(del);

    # A successful INSERT reports 1; out_affected = 0 tolerated.
    var ins = patra_prepare(db, "INSERT INTO people VALUES (4, 'd', 50)");
    assert_eq(patra_exec_returning(db, ins, 0), PATRA_OK, "null out ok");
    assert_eq(patra_rows_affected(db), 1, "insert affected 1");

    # Null handle: status error, out_affected zeroed (no stale value leaks).
    store64(n, 55);
    assert_eq(patra_exec_returning(0, ins, n), PATRA_ERR_IO, "null db => IO err");
    assert_eq(load64(n), 0, "out_affected zeroed on error");
    patra_finalize(ins);
    fl_free(n);
    patra_close(db);
}

# -- v1.10.2: TEXT column type -------------------------------

# Build "INSERT INTO bigt (body) VALUES ('<n × ch>')" and exec it. `ch` must be
# a quote-free, NUL-free byte so the SQL literal stays well-formed.
fn _text_big_insert(db, ch, n) {
    var buf = fl_alloc(n + 64);
    var pre = "INSERT INTO bigt (body) VALUES ('";
    var pl = strlen(pre);
    memcpy(buf, pre, pl);
    for (var i = 0; i < n; i = i + 1) { store8(buf + pl + i, ch); }
    store8(buf + pl + n, 39);       # closing quote '
    store8(buf + pl + n + 1, 41);   # )
    store8(buf + pl + n + 2, 0);    # NUL
    var r = patra_exec(db, buf);
    fl_free(buf);
    return r;
}

fn _all_byte(ptr, val, n) {
    for (var i = 0; i < n; i = i + 1) {
        if (load8(ptr + i) != val) { return 0; }
    }
    return 1;
}

fn test_parse_text() {
    test_group("parse text");
    sql_tokenize("CREATE TABLE t (id INT, body TEXT)");
    assert_eq(sql_parse(), PATRA_OK, "text col parses");
    sql_tokenize("ALTER TABLE t ADD COLUMN note TEXT");
    assert_eq(sql_parse(), PATRA_OK, "alter add text parses");
}

fn test_text_insert_read() {
    test_group("text insert read");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_exec(db, "CREATE TABLE t (id INT, body TEXT)"), PATRA_OK, "create");
    assert_eq(patra_exec(db, "INSERT INTO t (id, body) VALUES (1, 'hello world')"), PATRA_OK, "insert");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "1 row");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 11, "len 11");
    var out = fl_alloc(32);
    memset(out, 0, 32);
    assert_eq(patra_result_read_text(db, rs, 0, 1, out), PATRA_OK, "read ok");
    assert_streq(out, "hello world", "content");
    fl_free(out);
    patra_result_free(rs);
    patra_close(db);
}

fn test_text_exceeds_str_cap() {
    test_group("text exceeds 256");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE bigt (id INT AUTOINCREMENT, body TEXT)");
    # 300 bytes — beyond the 256-byte STR cap, single chain page.
    assert_eq(_text_big_insert(db, 65, 300), PATRA_OK, "insert 300B");
    var rs = patra_query(db, "SELECT * FROM bigt");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 300, "len 300");
    var out = fl_alloc(300);
    assert_eq(patra_result_read_text(db, rs, 0, 1, out), PATRA_OK, "read 300");
    assert_eq(_all_byte(out, 65, 300), 1, "300 bytes of 'A'");
    fl_free(out);
    patra_result_free(rs);
    patra_close(db);
}

fn test_text_multipage() {
    test_group("text multipage");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE bigt (id INT AUTOINCREMENT, body TEXT)");
    # 10000 bytes -> 3 chain pages (BY_DATA_MAX = 4072).
    assert_eq(_text_big_insert(db, 90, 10000), PATRA_OK, "insert 10k");
    var rs = patra_query(db, "SELECT * FROM bigt");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 10000, "len 10000");
    var out = fl_alloc(10000);
    assert_eq(patra_result_read_text(db, rs, 0, 1, out), PATRA_OK, "read 10k");
    assert_eq(_all_byte(out, 90, 10000), 1, "10k bytes of 'Z'");
    fl_free(out);
    patra_result_free(rs);
    patra_close(db);
}

fn test_text_empty() {
    test_group("text empty");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, body TEXT)");
    assert_eq(patra_exec(db, "INSERT INTO t (id, body) VALUES (1, '')"), PATRA_OK, "insert empty");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 0, "len 0");
    patra_result_free(rs);
    patra_close(db);
}

fn test_text_update() {
    test_group("text update");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, body TEXT)");
    patra_exec(db, "INSERT INTO t (id, body) VALUES (1, 'original')");
    assert_eq(patra_exec(db, "UPDATE t SET body = 'updated text' WHERE id = 1"), PATRA_OK, "update");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_get_text_len(rs, 0, 1), 12, "new len 12");
    var out = fl_alloc(32);
    memset(out, 0, 32);
    patra_result_read_text(db, rs, 0, 1, out);
