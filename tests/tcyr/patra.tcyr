    patra_close(db);
}

fn test_bytes_alter_drop_frees() {
    test_group("bytes alter drop frees");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objects (id INT, content BLOB)");

    var types = fl_alloc(16);
    var ivals = fl_alloc(16);
    var sptrs = fl_alloc(16);
    var slens = fl_alloc(16);
    var bptrs = fl_alloc(16);
    var blens = fl_alloc(16);
    memset(ivals, 0, 16); memset(sptrs, 0, 16); memset(slens, 0, 16);
    memset(bptrs, 0, 16); memset(blens, 0, 16);
    store64(types + 0, COL_INT);
    store64(types + 8, COL_BYTES);

    var payload = fl_alloc(9000);
    _bytes_fill(payload, 9000, 5);
    store64(bptrs + 8, payload);
    store64(blens + 8, 9000);
    for (var i = 1; i <= 3; i = i + 1) {
        store64(ivals + 0, i);
        patra_insert_row(db, "objects", 7, 2, types, ivals, sptrs, slens, bptrs, blens);
    }
    fl_free(types); fl_free(ivals); fl_free(sptrs);
    fl_free(slens); fl_free(bptrs); fl_free(blens);

    var hdr = _db_hdr(db);
    var fh_before = load64(hdr + HDR_FREEHEAD);

    assert_eq(patra_exec(db, "ALTER TABLE objects DROP COLUMN content"),
    PATRA_OK, "drop blob col");

    # Free list must have grown (chain pages reclaimed by drop)
    var fh_after = load64(hdr + HDR_FREEHEAD);
    assert_eq(fh_after != fh_before, 1, "free list changed");

    var rs = patra_query(db, "SELECT * FROM objects");
    assert_eq(patra_result_count(rs), 3, "3 rows kept");
    assert_eq(patra_result_cols(rs), 1, "1 col left");
    patra_result_free(rs);
    fl_free(payload);
    patra_close(db);
}

fn test_bytes_persistence() {
    test_group("bytes persistence");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objects (hash STR, content BLOB)");
    var payload = fl_alloc(5000);
    _bytes_fill(payload, 5000, 9);
    _obj_insert(db, "persist", payload, 5000);
    patra_close(db);

    var db2 = patra_open(_tpath);
    var rs = patra_query(db2, "SELECT * FROM objects");
    assert_eq(patra_result_count(rs), 1, "reopen 1 row");
    assert_eq(patra_result_get_bytes_len(rs, 0, 1), 5000, "len 5000");
    var out = fl_alloc(5000);
    memset(out, 0, 5000);
    assert_eq(patra_result_read_bytes(db2, rs, 0, 1, out), PATRA_OK, "read");
    assert_eq(_bytes_eq(payload, out, 5000), 1, "bytes equal");
    fl_free(out);
    fl_free(payload);
    patra_result_free(rs);
    patra_close(db2);
}

fn test_prepare_insert_select() {
    test_group("prepared INSERT + SELECT");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");

    var ins = patra_prepare(db, "INSERT INTO t VALUES (1, 'alice')");
    assert(ins != 0, "prepare insert ok");
    assert_eq(patra_exec_prepared(db, ins), PATRA_OK, "insert run 1");
    # Re-running the same prepared stmt -- same row inserted again.
    assert_eq(patra_exec_prepared(db, ins), PATRA_OK, "insert run 2");
    patra_finalize(ins);

    var sel = patra_prepare(db, "SELECT * FROM t");
    assert(sel != 0, "prepare select ok");
    var rs = patra_query_prepared(db, sel);
    assert_eq(patra_result_count(rs), 2, "two rows via prepared select");
    patra_result_free(rs);
    patra_finalize(sel);
    patra_close(db);
}

fn test_prepare_all_stmt_types() {
    test_group("prepared dispatch covers DDL/DML");
    cleanup();
    var db = patra_open(_tpath);
    var pc = patra_prepare(db, "CREATE TABLE t (id INT, name STR)");
    assert_eq(patra_exec_prepared(db, pc), PATRA_OK, "prepared CREATE");
    patra_finalize(pc);

    var pi = patra_prepare(db, "INSERT INTO t VALUES (1, 'a')");
    patra_exec_prepared(db, pi);
    patra_exec_prepared(db, pi);
    patra_exec_prepared(db, pi);
    patra_finalize(pi);

    var pu = patra_prepare(db, "UPDATE t SET name = 'b' WHERE id = 1");
    assert_eq(patra_exec_prepared(db, pu), PATRA_OK, "prepared UPDATE");
    patra_finalize(pu);

    var pd = patra_prepare(db, "DELETE FROM t WHERE id = 1");
    assert_eq(patra_exec_prepared(db, pd), PATRA_OK, "prepared DELETE");
    patra_finalize(pd);

    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 0, "all rows deleted");
    patra_result_free(rs);
    patra_close(db);
}

fn test_prepare_syntax_error() {
    test_group("prepared syntax error returns 0");
    cleanup();
    var db = patra_open(_tpath);
    var bad = patra_prepare(db, "BANANA");
    assert_eq(bad, 0, "bad SQL -> 0 stmt");
    patra_close(db);
}

fn test_prepare_owns_sql_buffer() {
    test_group("prepared stmt owns its SQL");
    # The stmt copies its SQL on prepare; freeing/overwriting the input
    # buffer afterwards must not affect later exec_prepared calls.
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT, name STR)");

    var sql = fl_alloc(64);
    var src = "INSERT INTO t VALUES (7, 'x')";
    var n = strlen(src);
    memcpy(sql, src, n);
    store8(sql + n, 0);
    var p = patra_prepare(db, sql);
    # Trash the input -- must not break the prepared stmt.
    memset(sql, 0, 64);
    fl_free(sql);

    assert_eq(patra_exec_prepared(db, p), PATRA_OK, "exec after input freed");
    var rs = patra_query(db, "SELECT * FROM t WHERE id = 7");
    assert_eq(patra_result_count(rs), 1, "row inserted");
    patra_result_free(rs);
    patra_finalize(p);
    patra_close(db);
}

fn test_prepare_finalize_safe() {
    test_group("patra_finalize handles 0");
    assert_eq(patra_finalize(0), 0, "finalize(0) is no-op");
}

fn test_prepare_str_index() {
    test_group("prepared INSERT OR IGNORE on STR-indexed");
    # Exercises the slab + memeq256 + prepared path together -- the three
    # 1.8.2 changes in one workload.
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('first', 1)");

    var p = patra_prepare(db, "INSERT OR IGNORE INTO objs VALUES ('first', 99)");
    # Run 10 times -- every run hits the conflict probe + memeq256 verify.
    for (var i = 0; i < 10; i = i + 1) {
        assert_eq(patra_exec_prepared(db, p), PATRA_OK, "ignored");
    }
    patra_finalize(p);
    var rs = patra_query(db, "SELECT * FROM objs");
    assert_eq(patra_result_count(rs), 1, "still 1 row");
    assert_eq(patra_result_get_int(rs, 0, 1), 1, "original val preserved");
    patra_result_free(rs);
    patra_close(db);
}

fn test_sync_mode_default_full() {
    test_group("sync mode default FULL");
    cleanup();
    var db = patra_open(_tpath);
    assert_eq(patra_get_sync_mode(db), PATRA_SYNC_FULL, "default FULL");
    patra_close(db);
}

fn test_sync_mode_batch_visibility() {
    test_group("BATCH mode same-process visibility");
    # In BATCH mode the writes aren't fsync'd per exec, but they're still
    # in OS page cache + addressable through this fd, so SELECTs see them.
    # Crash-durability isn't asserted here -- that needs OS-level coordination
    # we can't run inside the test binary.
    cleanup();
    var db = patra_open(_tpath);
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    patra_exec(db, "CREATE TABLE t (id INT, val STR)");
    for (var i = 0; i < 10; i = i + 1) {
        patra_exec(db, "INSERT INTO t VALUES (1, 'x')");
    }
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 10, "all 10 visible same process");
    patra_result_free(rs);
    patra_close(db);
}

fn test_sync_mode_flush_explicit() {
    test_group("explicit patra_flush clears pending");
    cleanup();
    var db = patra_open(_tpath);
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    patra_exec(db, "CREATE TABLE t (id INT)");
    patra_exec(db, "INSERT INTO t VALUES (1)");
    patra_exec(db, "INSERT INTO t VALUES (2)");
    # Flush forces the fdatasync; should be idempotent.
    assert_eq(patra_flush(db), PATRA_OK, "flush ok");
    assert_eq(patra_flush(db), PATRA_OK, "flush idempotent");
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 2, "both rows after flush");
    patra_result_free(rs);
    patra_close(db);
}

fn test_sync_mode_close_flushes() {
    test_group("patra_close flushes pending");
    cleanup();
    var db = patra_open(_tpath);
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    patra_exec(db, "CREATE TABLE t (id INT)");
    patra_exec(db, "INSERT INTO t VALUES (42)");
    # Close without explicit flush -- must not lose data.
    patra_close(db);

    var db2 = patra_open(_tpath);
    var rs = patra_query(db2, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 1, "row survives close");
    assert_eq(patra_result_get_int(rs, 0, 0), 42, "right val");
    patra_result_free(rs);
    patra_close(db2);
}

fn test_sync_mode_reopen_default() {
    test_group("sync mode resets to FULL on reopen");
    # The mode is per-handle, not persisted in the file. Reopening gives
    # back FULL even if the previous handle was BATCH.
    cleanup();
    var db = patra_open(_tpath);
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    patra_exec(db, "CREATE TABLE t (id INT)");
    patra_close(db);

    var db2 = patra_open(_tpath);
    assert_eq(patra_get_sync_mode(db2), PATRA_SYNC_FULL, "reopen -> FULL");
    patra_close(db2);
}

fn test_sync_mode_switch_flushes() {
    test_group("set_sync_mode flushes on switch");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE t (id INT)");
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    for (var i = 0; i < 5; i = i + 1) { patra_exec(db, "INSERT INTO t VALUES (1)"); }
    # Switching back to FULL flushes any pending writes.
    patra_set_sync_mode(db, PATRA_SYNC_FULL);
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 5, "5 rows after mode switch");
    patra_result_free(rs);
    patra_close(db);
}

fn test_sync_mode_auto_flush_threshold() {
    test_group("BATCH auto-flush at threshold");
    # PATRA_BATCH_FLUSH_N is 64. After 70 inserts in BATCH mode the auto-
    # flush has fired at least once; the data is consistent and reads
    # correctly afterwards.
    cleanup();
    var db = patra_open(_tpath);
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    patra_exec(db, "CREATE TABLE t (id INT)");
    for (var i = 0; i < 70; i = i + 1) { patra_exec(db, "INSERT INTO t VALUES (1)"); }
    var rs = patra_query(db, "SELECT * FROM t");
    assert_eq(patra_result_count(rs), 70, "70 rows after auto-flush");
    patra_result_free(rs);
    patra_close(db);
}

fn test_str_index_create() {
    test_group("STR index create + select");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "INSERT INTO objs VALUES ('aaa', 1)");
    patra_exec(db, "INSERT INTO objs VALUES ('bbb', 2)");
    patra_exec(db, "INSERT INTO objs VALUES ('ccc', 3)");
    assert_eq(patra_exec(db, "CREATE INDEX ON objs (hash)"), PATRA_OK, "STR index ok");

    var rs = patra_query(db, "SELECT * FROM objs WHERE hash = 'bbb'");
    assert_eq(patra_result_count(rs), 1, "1 row matches");
    assert_eq(patra_result_get_int(rs, 0, 1), 2, "right row (val=2)");
    patra_result_free(rs);

    var rs2 = patra_query(db, "SELECT * FROM objs WHERE hash = 'zzz'");
    assert_eq(patra_result_count(rs2), 0, "no rows match");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_str_index_or_ignore_dedup() {
    test_group("STR-indexed INSERT OR IGNORE dedup");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('alpha', 100)");
    patra_exec(db, "INSERT INTO objs VALUES ('beta', 200)");

    # Conflicting hash 'alpha' -- must be ignored, original val preserved.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO objs VALUES ('alpha', 999)"), PATRA_OK, "ignored");
    var rs = patra_query(db, "SELECT * FROM objs WHERE hash = 'alpha'");
    assert_eq(patra_result_count(rs), 1, "still 1 alpha");
    assert_eq(patra_result_get_int(rs, 0, 1), 100, "original val preserved");
    patra_result_free(rs);

    # Non-conflicting hash 'gamma' -- must insert.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO objs VALUES ('gamma', 300)"), PATRA_OK, "miss inserts");
    var rs2 = patra_query(db, "SELECT * FROM objs");
    assert_eq(patra_result_count(rs2), 3, "3 rows total");
    patra_result_free(rs2);
    patra_close(db);
}

# Helper: insert (hash STR, ty INT, content BYTES) — sit's object-store shape —
# via patra_insert_row (or_ignore == 0) or patra_insert_row_or_ignore (== 1).
fn _oi_insert(db, tname, tnlen, hash, ty, content, clen, or_ignore) {
    var types = fl_alloc(3 * 8);
    var ivals = fl_alloc(3 * 8);
    var sptrs = fl_alloc(3 * 8);
    var slens = fl_alloc(3 * 8);
    var bptrs = fl_alloc(3 * 8);
    var blens = fl_alloc(3 * 8);
    memset(ivals, 0, 24); memset(sptrs, 0, 24); memset(slens, 0, 24);
    memset(bptrs, 0, 24); memset(blens, 0, 24);
    store64(types + 0 * 8, COL_STR);
    store64(sptrs + 0 * 8, hash); store64(slens + 0 * 8, strlen(hash));
    store64(types + 1 * 8, COL_INT); store64(ivals + 1 * 8, ty);
    store64(types + 2 * 8, COL_BYTES);
    store64(bptrs + 2 * 8, content); store64(blens + 2 * 8, clen);
    var r = 0;
    if (or_ignore != 0) {
        r = patra_insert_row_or_ignore(db, tname, tnlen, 3, types, ivals, sptrs, slens, bptrs, blens);
    } else {
        r = patra_insert_row(db, tname, tnlen, 3, types, ivals, sptrs, slens, bptrs, blens);
    }
    fl_free(types); fl_free(ivals); fl_free(sptrs);
    fl_free(slens); fl_free(bptrs); fl_free(blens);
    return r;
}

fn test_insert_row_or_ignore() {
    test_group("patra_insert_row OR IGNORE");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objects (hash STR, ty INT, content BYTES)");
    patra_exec(db, "CREATE INDEX ON objects (hash)");

    var p1 = fl_alloc(64); _bytes_fill(p1, 40, 7);
    var p2 = fl_alloc(64); _bytes_fill(p2, 40, 9);

    # Fresh key inserts; rows_affected == 1.
    assert_eq(_oi_insert(db, "objects", 7, "deadbeef", 1, p1, 40, 1), PATRA_OK, "fresh insert ok");
    assert_eq(patra_rows_affected(db), 1, "fresh => 1 inserted");

    # Same key ignored: PATRA_OK, rows_affected == 0, original row untouched
    # (ty stays 1, content stays p1 — the conflicting payload p2 is discarded).
    assert_eq(_oi_insert(db, "objects", 7, "deadbeef", 2, p2, 40, 1), PATRA_OK, "dup insert ok");
    assert_eq(patra_rows_affected(db), 0, "dup => 0 ignored");
    var rs = patra_query(db, "SELECT * FROM objects");
    assert_eq(patra_result_count(rs), 1, "still 1 row after dup");
    assert_eq(patra_result_get_int(rs, 0, 1), 1, "original ty preserved");
    var out = fl_alloc(64); memset(out, 0, 64);
    assert_eq(patra_result_read_bytes(db, rs, 0, 2, out), PATRA_OK, "read content ok");
    assert_eq(_bytes_eq(p1, out, 40), 1, "original content preserved");
    patra_result_free(rs);

    # Different key inserts; rows_affected == 1.
    assert_eq(_oi_insert(db, "objects", 7, "cafef00d", 3, p2, 40, 1), PATRA_OK, "new key ok");
    assert_eq(patra_rows_affected(db), 1, "new key => 1");
    var rs2 = patra_query(db, "SELECT * FROM objects");
    assert_eq(patra_result_count(rs2), 2, "2 rows total");
    patra_result_free(rs2);

    # Plain patra_insert_row (no OR IGNORE) still inserts unconditionally — the
    # secondary index is non-unique, so the key duplicates.
    assert_eq(_oi_insert(db, "objects", 7, "deadbeef", 5, p2, 40, 0), PATRA_OK, "plain insert ok");
    var rs3 = patra_query(db, "SELECT * FROM objects WHERE hash = 'deadbeef'");
    assert_eq(patra_result_count(rs3), 2, "plain insert duplicated the key");
    patra_result_free(rs3);

    # No index => nothing to dedup => OR IGNORE always inserts.
    patra_exec(db, "CREATE TABLE noidx (hash STR, ty INT, content BYTES)");
    assert_eq(_oi_insert(db, "noidx", 5, "k", 1, p1, 40, 1), PATRA_OK, "noidx insert 1");
    assert_eq(patra_rows_affected(db), 1, "noidx => 1");
    assert_eq(_oi_insert(db, "noidx", 5, "k", 2, p1, 40, 1), PATRA_OK, "noidx insert 2");
    assert_eq(patra_rows_affected(db), 1, "noidx dup still inserts => 1");
    var rsn = patra_query(db, "SELECT * FROM noidx");
    assert_eq(patra_result_count(rsn), 2, "noidx kept both rows");
    patra_result_free(rsn);
    patra_close(db);

    # Persistence: index survives reopen, OR IGNORE still dedups.
    var db2 = patra_open(_tpath);
    assert_eq(_oi_insert(db2, "objects", 7, "cafef00d", 9, p1, 40, 1), PATRA_OK, "reopen dup ok");
    assert_eq(patra_rows_affected(db2), 0, "reopen => still ignored");
    patra_close(db2);
}

# Helper: insert (id INT, content BYTES) via patra_insert_row[_or_ignore].
fn _io_insert(db, tname, tnlen, id, content, clen, or_ignore) {
    var types = fl_alloc(16); var ivals = fl_alloc(16);
    var sptrs = fl_alloc(16); var slens = fl_alloc(16);
    var bptrs = fl_alloc(16); var blens = fl_alloc(16);
    memset(ivals, 0, 16); memset(sptrs, 0, 16); memset(slens, 0, 16);
    memset(bptrs, 0, 16); memset(blens, 0, 16);
    store64(types + 0, COL_INT); store64(ivals + 0, id);
    store64(types + 8, COL_BYTES); store64(bptrs + 8, content); store64(blens + 8, clen);
    var r = 0;
    if (or_ignore != 0) {
        r = patra_insert_row_or_ignore(db, tname, tnlen, 2, types, ivals, sptrs, slens, bptrs, blens);
    } else {
        r = patra_insert_row(db, tname, tnlen, 2, types, ivals, sptrs, slens, bptrs, blens);
    }
    fl_free(types); fl_free(ivals); fl_free(sptrs);
    fl_free(slens); fl_free(bptrs); fl_free(blens);
    return r;
}

fn test_insert_row_or_ignore_int() {
    test_group("patra_insert_row OR IGNORE (INT index, tombstone)");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE iobj (id INT, content BYTES)");
    patra_exec(db, "CREATE INDEX ON iobj (id)");

    var q1 = fl_alloc(64); _bytes_fill(q1, 32, 3);
    var q2 = fl_alloc(64); _bytes_fill(q2, 32, 8);

    # Fresh INT key inserts; dup ignored.
    assert_eq(_io_insert(db, "iobj", 4, 5, q1, 32, 1), PATRA_OK, "int fresh ok");
    assert_eq(patra_rows_affected(db), 1, "int fresh => 1");
    assert_eq(_io_insert(db, "iobj", 4, 5, q2, 32, 1), PATRA_OK, "int dup ok");
    assert_eq(patra_rows_affected(db), 0, "int dup => 0 ignored");

    # DELETE then OR IGNORE must RE-INSERT. Regression guard: a lazy-deleted INT
    # key keeps a -1 tombstone in the index; a count-only probe used to false-hit
    # it and silently drop this write.
    assert_eq(patra_exec(db, "DELETE FROM iobj WHERE id = 5"), PATRA_OK, "delete ok");
    assert_eq(_io_insert(db, "iobj", 4, 5, q2, 32, 1), PATRA_OK, "reinsert ok");
    assert_eq(patra_rows_affected(db), 1, "reinsert after delete => 1");
    var rs = patra_query(db, "SELECT * FROM iobj WHERE id = 5");
    assert_eq(patra_result_count(rs), 1, "row present after reinsert");
    var out = fl_alloc(64); memset(out, 0, 64);
    assert_eq(patra_result_read_bytes(db, rs, 0, 1, out), PATRA_OK, "read reinserted content");
    assert_eq(_bytes_eq(q2, out, 32), 1, "reinserted content is the new payload");
    patra_result_free(rs);

    # Same tombstone path on the SQL INSERT OR IGNORE INT probe (pre-existing).
    patra_exec(db, "CREATE TABLE r (id INT, val STR)");
    patra_exec(db, "CREATE INDEX ON r (id)");
    patra_exec(db, "INSERT INTO r VALUES (7, 'a')");
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO r VALUES (7, 'b')"), PATRA_OK, "sql dup ok");
    assert_eq(patra_rows_affected(db), 0, "sql dup => 0 ignored");
    patra_exec(db, "DELETE FROM r WHERE id = 7");
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO r VALUES (7, 'c')"), PATRA_OK, "sql reinsert ok");
    assert_eq(patra_rows_affected(db), 1, "sql reinsert after delete => 1");
    var rs2 = patra_query(db, "SELECT * FROM r WHERE id = 7");
    assert_eq(patra_result_count(rs2), 1, "sql row present after reinsert");
    assert_eq(patra_result_get_int(rs2, 0, 0), 7, "sql id correct");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_str_index_update_maintains() {
    test_group("STR index UPDATE keeps tree consistent");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('old', 1)");
    patra_exec(db, "UPDATE objs SET hash = 'new' WHERE val = 1");

    # Old key must miss, new key must hit through the index.
    var rs1 = patra_query(db, "SELECT * FROM objs WHERE hash = 'old'");
    assert_eq(patra_result_count(rs1), 0, "old hash gone");
    patra_result_free(rs1);
    var rs2 = patra_query(db, "SELECT * FROM objs WHERE hash = 'new'");
    assert_eq(patra_result_count(rs2), 1, "new hash hits");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_str_index_delete_maintains() {
    test_group("STR index DELETE drops ref");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('a', 1)");
    patra_exec(db, "INSERT INTO objs VALUES ('b', 2)");
    patra_exec(db, "DELETE FROM objs WHERE hash = 'a'");

    var rs = patra_query(db, "SELECT * FROM objs WHERE hash = 'a'");
    assert_eq(patra_result_count(rs), 0, "deleted row gone");
    patra_result_free(rs);
    # And subsequent INSERT OR IGNORE on the freed key inserts cleanly.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO objs VALUES ('a', 11)"), PATRA_OK, "reinsert ok");
    var rs2 = patra_query(db, "SELECT * FROM objs WHERE hash = 'a'");
    assert_eq(patra_result_count(rs2), 1, "1 row");
    assert_eq(patra_result_get_int(rs2, 0, 1), 11, "fresh val");
    patra_result_free(rs2);
    patra_close(db);
}

fn test_str_index_persistence() {
    test_group("STR index persistence");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    patra_exec(db, "INSERT INTO objs VALUES ('persist', 42)");
    patra_close(db);

    var db2 = patra_open(_tpath);
    # Index survives reopen; OR IGNORE still fires.
    assert_eq(patra_exec(db2, "INSERT OR IGNORE INTO objs VALUES ('persist', 999)"), PATRA_OK, "ignored");
    var rs = patra_query(db2, "SELECT * FROM objs WHERE hash = 'persist'");
    assert_eq(patra_result_count(rs), 1, "1 row");
    assert_eq(patra_result_get_int(rs, 0, 1), 42, "original val preserved");
    patra_result_free(rs);
    patra_close(db2);
}

fn test_str_index_collision_safety() {
    test_group("STR index hash collision safety");
    # Collisions are rare with djb2-64 but the verify step must still
    # filter them. We can't easily engineer a real collision here, but we
    # exercise the candidate-loop path with many same-hash queries.
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE objs (hash STR, val INT)");
    patra_exec(db, "CREATE INDEX ON objs (hash)");
    # Distinct hashes that all collide on a degenerate hash (none expected
    # for djb2 over short distinct strings) -- at minimum, exercise the
    # verify-on-hit path with 50 distinct STR keys.
    for (var i = 0; i < 50; i = i + 1) {
        var sb = fl_alloc(8);
        memset(sb, 0, 8);
        store8(sb + 0, 97 + (i / 25));     # 'a' or 'b'
        store8(sb + 1, 97 + (i % 25));     # rotates 'a'..'y'
        var ts = fl_alloc(2 * 8);
        var iv = fl_alloc(2 * 8);
        var sp = fl_alloc(2 * 8);
        var sl = fl_alloc(2 * 8);
        memset(iv, 0, 16); memset(sp, 0, 16); memset(sl, 0, 16);
        store64(ts + 0, COL_STR);
        store64(sp + 0, sb);
        store64(sl + 0, 2);
        store64(ts + 8, COL_INT);
        store64(iv + 8, i);
        patra_insert_row(db, "objs", 4, 2, ts, iv, sp, sl, 0, 0);
        fl_free(sl); fl_free(sp); fl_free(iv); fl_free(ts); fl_free(sb);
    }
    var rs = patra_query(db, "SELECT * FROM objs");
    assert_eq(patra_result_count(rs), 50, "50 rows");
    patra_result_free(rs);

    # Each lookup must return exactly the one matching row regardless
    # of how many candidates the hash bucket holds.
    var qb = fl_alloc(8);
    memset(qb, 0, 8);
    store8(qb, 98);     # 'b'
    store8(qb + 1, 109); # 'm' -> "bm"
    var rs2 = patra_query(db, "SELECT * FROM objs WHERE hash = 'bm'");
    assert_eq(patra_result_count(rs2), 1, "exactly 1 match for 'bm'");
    fl_free(qb);
    patra_result_free(rs2);
    patra_close(db);
}

fn test_parse_insert_or_ignore() {
    test_group("parse INSERT OR IGNORE");
    sql_tokenize("INSERT INTO users VALUES (1, 'alice')");
    assert_eq(sql_parse(), PATRA_OK, "vanilla parses");
    assert_eq(load64(_spr() + PR_INSERT_IGNORE), 0, "vanilla flag clear");
    sql_tokenize("INSERT OR IGNORE INTO users VALUES (1, 'alice')");
    assert_eq(sql_parse(), PATRA_OK, "ignore variant parses");
    assert_eq(load64(_spr() + PR_STMT), STMT_INSERT, "stmt insert");
    assert_eq(load64(_spr() + PR_INSERT_IGNORE), 1, "ignore flag set");
    assert_eq(load64(_spr() + PR_COUNT), 2, "2 values");
    sql_tokenize("INSERT OR REPLACE INTO users VALUES (1, 'alice')");
    assert_eq(sql_parse(), PATRA_ERR_SYNTAX, "OR <other> rejected");
    sql_tokenize("insert or ignore into users values (1, 'alice')");
    assert_eq(sql_parse(), PATRA_OK, "lowercase ok");
    assert_eq(load64(_spr() + PR_INSERT_IGNORE), 1, "lowercase flag set");
}

fn test_insert_or_ignore_dedup() {
    test_group("INSERT OR IGNORE dedup hit");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE refs (id INT, name STR)");
    patra_exec(db, "CREATE INDEX ON refs (id)");
    assert_eq(patra_exec(db, "INSERT INTO refs VALUES (1, 'alpha')"), PATRA_OK, "seed 1");
    assert_eq(patra_exec(db, "INSERT INTO refs VALUES (2, 'beta')"),  PATRA_OK, "seed 2");
    # Conflicting id=1: returns OK (not an error) and the original row is untouched.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO refs VALUES (1, 'GAMMA')"), PATRA_OK, "ignored ok");
    var rs = patra_query(db, "SELECT * FROM refs");
    assert_eq(patra_result_count(rs), 2, "still 2 rows");
    var rs2 = patra_query(db, "SELECT * FROM refs WHERE id = 1");
    assert_eq(patra_result_count(rs2), 1, "id=1 unique");
    assert_streq(patra_result_get_str(rs2, 0, 1), "alpha", "original preserved");
    patra_result_free(rs2);
    patra_result_free(rs);
    patra_close(db);
}

fn test_insert_or_ignore_miss() {
    test_group("INSERT OR IGNORE dedup miss");
    cleanup();
    var db = patra_open(_tpath);
    patra_exec(db, "CREATE TABLE refs (id INT, name STR)");
    patra_exec(db, "CREATE INDEX ON refs (id)");
    patra_exec(db, "INSERT INTO refs VALUES (1, 'alpha')");
    # Non-conflicting id=2: insert proceeds.
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO refs VALUES (2, 'beta')"), PATRA_OK, "miss inserts");
    var rs = patra_query(db, "SELECT * FROM refs");
    assert_eq(patra_result_count(rs), 2, "2 rows after miss");
    patra_result_free(rs);
    patra_close(db);
}

fn test_insert_or_ignore_no_index() {
    test_group("INSERT OR IGNORE no index");
    cleanup();
    var db = patra_open(_tpath);
    # First column STR -> auto-index doesn't fire (auto-index is INT-only,
    # table.cyr:80-88) and no CREATE INDEX issued -> no conflict surface.
    # INSERT OR IGNORE must behave as plain INSERT in this case.
    patra_exec(db, "CREATE TABLE notes (body STR, id INT)");
    patra_exec(db, "INSERT INTO notes VALUES ('first', 1)");
    assert_eq(patra_exec(db, "INSERT OR IGNORE INTO notes VALUES ('second', 1)"), PATRA_OK, "no index ok");
    var rs = patra_query(db, "SELECT * FROM notes");
    assert_eq(patra_result_count(rs), 2, "both rows present without index");
    patra_result_free(rs);
    patra_close(db);
}

