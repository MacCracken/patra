    assert_eq(patra_exec(db, "VACUUM ghost"), PATRA_ERR_NOTFOUND, "unknown");
    patra_close(db);
}

# -- v1.3: LIKE operator --------------------------------------

fn test_parse_like() {
    test_group("parse like");
    sql_tokenize("SELECT * FROM t WHERE name LIKE 'a%'");
    assert_eq(sql_parse(), PATRA_OK, "like parse ok");
    assert_eq(load64(_spr() + PR_WHERE_N), 1, "1 cond");
    var cond = _spr() + PR_WHERE;
    assert_eq(load64(cond + WH_CMP_OP), CMP_LIKE, "op=LIKE");
    assert_eq(load64(cond + WH_VAL_TYPE), COL_STR, "str value");
}

fn test_like_prefix() {
    test_group("like prefix");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # Prefix match: names starting with 'a' or 'b'
    var rs = patra_query(db, "SELECT * FROM people WHERE name LIKE 'a%'");
    assert_eq(patra_result_count(rs), 1, "alice");
    assert_streq(patra_result_get_str(rs, 0, 1), "alice", "matched alice");
    patra_result_free(rs);

    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE 'b%'");
    assert_eq(patra_result_count(rs), 1, "bob");
    patra_result_free(rs);

    # No match
    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE 'z%'");
    assert_eq(patra_result_count(rs), 0, "no z");
    patra_result_free(rs);

    patra_close(db);
}

fn test_like_suffix() {
    test_group("like suffix");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # Suffix match
    var rs = patra_query(db, "SELECT * FROM people WHERE name LIKE '%e'");
    # alice, carol, eve, dave? alice(a-l-i-c-e) ends 'e'; eve ends 'e'; dave ends 'e'; carol ends 'l'; bob ends 'b'
    assert_eq(patra_result_count(rs), 3, "alice, eve, dave");
    patra_result_free(rs);

    patra_close(db);
}

fn test_like_contains() {
    test_group("like contains");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # %a% -> names containing 'a'
    var rs = patra_query(db, "SELECT * FROM people WHERE name LIKE '%a%'");
    # alice, carol, dave all contain 'a'; bob, eve don't
    assert_eq(patra_result_count(rs), 3, "3 contain a");
    patra_result_free(rs);

    # %l% -> alice, carol
    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE '%l%'");
    assert_eq(patra_result_count(rs), 2, "2 contain l");
    patra_result_free(rs);

    patra_close(db);
}

fn test_like_underscore() {
    test_group("like underscore");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # b_b -> exactly 3 chars, starts with b, ends with b
    var rs = patra_query(db, "SELECT * FROM people WHERE name LIKE 'b_b'");
    assert_eq(patra_result_count(rs), 1, "matched bob");
    assert_streq(patra_result_get_str(rs, 0, 1), "bob", "is bob");
    patra_result_free(rs);

    # 3 chars, any
    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE '___'");
    assert_eq(patra_result_count(rs), 2, "3-char names: bob, eve");
    patra_result_free(rs);

    patra_close(db);
}

fn test_like_literal() {
    test_group("like literal");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # No wildcards -> exact equality semantics
    var rs = patra_query(db, "SELECT * FROM people WHERE name LIKE 'alice'");
    assert_eq(patra_result_count(rs), 1, "exact alice");
    patra_result_free(rs);

    # Empty pattern matches empty string only
    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE ''");
    assert_eq(patra_result_count(rs), 0, "empty pattern no match");
    patra_result_free(rs);

    # % alone matches all
    rs = patra_query(db, "SELECT * FROM people WHERE name LIKE '%'");
    assert_eq(patra_result_count(rs), 5, "% matches all");
    patra_result_free(rs);

    patra_close(db);
}

# -- v1.2: SELECT column list ---------------------------------

fn test_select_col_single() {
    test_group("select col single");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    var rs = patra_query(db, "SELECT name FROM people");
    assert(rs != 0, "query ok");
    assert_eq(patra_result_count(rs), 5, "5 rows");
    assert_eq(patra_result_cols(rs), 1, "1 col");
    assert_streq(patra_result_col_name(rs, 0), "name", "col name");
    assert_streq(patra_result_get_str(rs, 0, 0), "alice", "row0");
    assert_streq(patra_result_get_str(rs, 4, 0), "eve", "row4");
    patra_result_free(rs);

    patra_close(db);
}

fn test_select_col_multi() {
    test_group("select col multi");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # Project (name, age) -- drop id, reorder
    var rs = patra_query(db, "SELECT name, age FROM people");
    assert_eq(patra_result_cols(rs), 2, "2 cols");
    assert_streq(patra_result_col_name(rs, 0), "name", "col0=name");
    assert_streq(patra_result_col_name(rs, 1), "age", "col1=age");
    assert_streq(patra_result_get_str(rs, 0, 0), "alice", "alice name");
    assert_eq(patra_result_get_int(rs, 0, 1), 30, "alice age");
    assert_streq(patra_result_get_str(rs, 1, 0), "bob", "bob name");
    assert_eq(patra_result_get_int(rs, 1, 1), 25, "bob age");
    patra_result_free(rs);

    # Reorder: age, id, name
    rs = patra_query(db, "SELECT age, id, name FROM people");
    assert_eq(patra_result_cols(rs), 3, "3 cols reordered");
    assert_eq(patra_result_get_int(rs, 0, 0), 30, "r0 age");
    assert_eq(patra_result_get_int(rs, 0, 1), 1, "r0 id");
    assert_streq(patra_result_get_str(rs, 0, 2), "alice", "r0 name");
    patra_result_free(rs);

    patra_close(db);
}

fn test_select_col_where_order_limit() {
    test_group("select col where order limit");
    cleanup();
    var db = patra_open(_tpath);
    _setup_people(db);

    # Projection with WHERE referencing non-projected col
    var rs = patra_query(db, "SELECT name FROM people WHERE age > 28");
    assert_eq(patra_result_count(rs), 3, "age>28: 3 rows");
    assert_eq(patra_result_cols(rs), 1, "1 col");
    patra_result_free(rs);

    # ORDER BY on non-projected col (sort runs before projection)
    rs = patra_query(db, "SELECT name FROM people ORDER BY age");
    assert_eq(patra_result_count(rs), 5, "5 rows");
    assert_streq(patra_result_get_str(rs, 4, 0), "eve", "last = eve (age 40)");
    patra_result_free(rs);

    # Projection + LIMIT
    rs = patra_query(db, "SELECT id, name FROM people LIMIT 2");
    assert_eq(patra_result_count(rs), 2, "limit 2");
    assert_eq(patra_result_cols(rs), 2, "2 cols");
    patra_result_free(rs);

    patra_close(db);
}

