# fuzz_file.fcyr -- Malformed .patra file invariant checks
# Tests that corrupt/truncated files are rejected gracefully.
# Exit 0 = all pass. Non-zero = invariant ID that failed.

include "src/lib.cyr"

alloc_init();
fl_init();
patra_init();

var fpath = "/tmp/patra_fuzz_file.patra";

# -- Wrong magic ---------------------------------------------

# Write a file with garbage magic
xunlink(fpath);
var fd = file_open(fpath, O_RDWR | O_CREAT | O_EXCL, 420);
var buf = fl_alloc(PAGE_SIZE);
memset(buf, 0, PAGE_SIZE);
store32(buf, 0xDEADBEEF);
sys_write(fd, buf, PAGE_SIZE);
sys_close(fd);

# patra_open should reject it
var db = patra_open(fpath);
if (db != 0) { sys_exit(1); }

# -- Truncated file (< 4096 bytes) ---------------------------

xunlink(fpath);
fd = file_open(fpath, O_RDWR | O_CREAT | O_EXCL, 420);
sys_write(fd, "PTRA", 4);
sys_close(fd);

db = patra_open(fpath);
if (db != 0) { sys_exit(2); }

# -- Zero-length file ----------------------------------------

xunlink(fpath);
fd = file_open(fpath, O_RDWR | O_CREAT | O_EXCL, 420);
sys_close(fd);

# patra_open on empty existing file rejects (can't read header)
db = patra_open(fpath);
if (db != 0) { patra_close(db); sys_exit(3); }
xunlink(fpath);

# -- Valid file -- basic operations must work ------------------

xunlink(fpath);
db = patra_open(fpath);
if (db == 0) { sys_exit(10); }
if (patra_exec(db, "CREATE TABLE t (id INT, v STR)") != PATRA_OK) { sys_exit(11); }
if (patra_exec(db, "INSERT INTO t VALUES (1, 'a')") != PATRA_OK) { sys_exit(12); }
if (patra_exec(db, "INSERT INTO t VALUES (2, 'b')") != PATRA_OK) { sys_exit(13); }

var rs = patra_query(db, "SELECT * FROM t");
if (rs == 0) { sys_exit(14); }
if (patra_result_count(rs) != 2) { sys_exit(15); }
patra_result_free(rs);

# WHERE on indexed column
rs = patra_query(db, "SELECT * FROM t WHERE id = 1");
if (patra_result_count(rs) != 1) { sys_exit(16); }
patra_result_free(rs);

# UPDATE
if (patra_exec(db, "UPDATE t SET v = 'A' WHERE id = 1") != PATRA_OK) { sys_exit(17); }
rs = patra_query(db, "SELECT * FROM t WHERE id = 1");
if (streq(patra_result_get_str(rs, 0, 1), "A") != 1) { sys_exit(18); }
patra_result_free(rs);

# DELETE
if (patra_exec(db, "DELETE FROM t WHERE id = 2") != PATRA_OK) { sys_exit(19); }
rs = patra_query(db, "SELECT * FROM t");
if (patra_result_count(rs) != 1) { sys_exit(20); }
patra_result_free(rs);

# ORDER BY + LIMIT
patra_exec(db, "INSERT INTO t VALUES (5, 'e')");
patra_exec(db, "INSERT INTO t VALUES (3, 'c')");
rs = patra_query(db, "SELECT * FROM t ORDER BY id LIMIT 1");
if (patra_result_count(rs) != 1) { sys_exit(21); }
if (patra_result_get_int(rs, 0, 0) != 1) { sys_exit(22); }
patra_result_free(rs);

patra_close(db);

# -- Reopen and verify persistence ----------------------------

db = patra_open(fpath);
if (db == 0) { sys_exit(30); }
rs = patra_query(db, "SELECT * FROM t");
if (patra_result_count(rs) != 3) { sys_exit(31); }
patra_result_free(rs);
patra_close(db);

# -- JSONL round-trip -----------------------------------------

var jpath = "/tmp/patra_fuzz_file.jsonl";
xunlink(jpath);
var jfd = jsonl_open(jpath);
if (jfd < 0) { sys_exit(40); }

jsonl_append(jfd, "{\"a\": 1}", 8);
jsonl_append(jfd, "{\"b\": 2}", 8);
if (jsonl_count(jfd) != 2) { sys_exit(41); }

var lr = jsonl_read(jfd);
if (jsonl_lines_count(lr) != 2) { sys_exit(42); }
if (jsonl_lines_len(lr, 0) != 8) { sys_exit(43); }
jsonl_lines_free(lr);
jsonl_close(jfd);

# Read back after close/reopen
jfd = jsonl_open(jpath);
lr = jsonl_read(jfd);
if (jsonl_lines_count(lr) != 2) { sys_exit(44); }
jsonl_lines_free(lr);
jsonl_close(jfd);
xunlink(jpath);

# -- Header verify edge cases --------------------------------

# All 0xFF
memset(buf, 255, PAGE_SIZE);
if (patra_hdr_verify(buf) == PATRA_OK) { sys_exit(50); }

# Correct magic but wrong version -- rejected as of 1.5.1 (audit 2026-04-21 §3.7)
patra_hdr_init(buf);
store32(buf + 4, 99);
if (patra_hdr_verify(buf) == PATRA_OK) { sys_exit(51); }

# Over-cap table count -- rejected as of 1.5.1
patra_hdr_init(buf);
store64(buf + HDR_TBLCOUNT, 1000);
if (patra_hdr_verify(buf) == PATRA_OK) { sys_exit(52); }

# Out-of-range freehead -- rejected as of 1.5.1
patra_hdr_init(buf);
store64(buf + HDR_PGCOUNT, 10);
store64(buf + HDR_FREEHEAD, 99);
if (patra_hdr_verify(buf) == PATRA_OK) { sys_exit(53); }

fl_free(buf);
xunlink(fpath);

sys_exit(0);
